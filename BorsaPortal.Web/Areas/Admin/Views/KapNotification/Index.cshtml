@model IEnumerable<BorsaPortal.Domain.Entities.KapNotification>

@{
    ViewBag.Title = "KAP Bildirimleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>KAP Bildirimleri</h2>
    <div>
        @using (Html.BeginForm("SyncFromKap", "KapNotification", FormMethod.Post, new { @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="days" value="1" />
            <button type="submit" class="btn btn-success me-2" onclick="return confirm('KAP\'tan son 1 günün bildirimlerini çekmek istiyor musunuz?');">
                <i class="bi bi-arrow-repeat"></i> KAP'tan Senkronize Et
            </button>
        }
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Bildirim Ekle
        </a>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Şirket Filtrele</label>
                @Html.DropDownList("companyId", (SelectList)ViewBag.Companies, "-- Tüm Şirketler --", new { @class = "form-select", onchange = "this.form.submit()" })
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Şirket</th>
                            <th>Başlık</th>
                            <th>Tür</th>
                            <th>Bildirim No</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.PublishDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td><strong>@item.Company.Code</strong></td>
                                <td>@item.Title</td>
                                <td>
                                    <span class="badge bg-info">
                                        @switch (item.NotificationType)
                                        {
                                            case BorsaPortal.Domain.Enums.KapNotificationType.FinancialStatement: @:Mali Tablo
                                                break;
                                            case BorsaPortal.Domain.Enums.KapNotificationType.MaterialDisclosure: @:Özel Durum
                                                break;
                                            default: @item.NotificationType.ToString()
                                                break;
                                        }
                                    </span>
                                </td>
                                <td>@item.NotificationNumber</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.SourceUrl))
                                    {
                                        <a href="@item.SourceUrl" target="_blank" class="btn btn-sm btn-outline-info" title="KAP'ta Görüntüle">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    }
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                Henüz KAP bildirimi eklenmemiş. <a href="@Url.Action("Create")">Yeni bildirim ekle</a>
            </div>
        }
    </div>
</div>
