@model BorsaPortal.Web.Areas.Admin.ViewModels.RssFeedSourceViewModel

@{
    ViewBag.Title = "RSS Feed Kaynağını Düzenle";
}

<h2><i class="bi bi-pencil"></i> RSS Feed Kaynağını Düzenle</h2>

<hr />

<div class="row">
    <div class="col-md-8">
        @using (Html.BeginForm("Edit", "RssFeedSource", FormMethod.Post, new { @class = "needs-validation" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.ItemsFetchedCount)
            @Html.HiddenFor(model => model.LastFetchedAt)

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Temel Bilgiler</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        @Html.LabelFor(model => model.Name, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Name, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.Description, new { @class = "form-label" })
                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", rows = 2 })
                        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.FeedUrl, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.FeedUrl, new { @class = "form-control", type = "url" })
                        @Html.ValidationMessageFor(model => model.FeedUrl, "", new { @class = "text-danger" })
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.SectorId, new { @class = "form-label" })
                            @Html.DropDownList("SectorId", (SelectList)ViewBag.Sectors, "-- Sektör Seçiniz (Opsiyonel) --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.SectorId, "", new { @class = "text-danger" })
                        </div>

                        <div class="col-md-6 mb-3">
                            @Html.LabelFor(model => model.FetchIntervalMinutes, new { @class = "form-label" })
                            @Html.TextBoxFor(model => model.FetchIntervalMinutes, new { @class = "form-control", type = "number", min = 15, max = 1440 })
                            @Html.ValidationMessageFor(model => model.FetchIntervalMinutes, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Son Çekilme Zamanı</label>
                            <input type="text" class="form-control" value="@(Model.LastFetchedAt?.ToString("dd.MM.yyyy HH:mm") ?? "Henüz çekilmedi")" readonly />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Toplam Çekilen Haber</label>
                            <input type="text" class="form-control" value="@Model.ItemsFetchedCount" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Filtreleme Ayarları</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        @Html.LabelFor(model => model.IncludeKeywords, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.IncludeKeywords, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.IncludeKeywords, "", new { @class = "text-danger" })
                        <small class="form-text text-muted">Virgülle ayrılmış anahtar kelimeler</small>
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(model => model.ExcludeKeywords, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.ExcludeKeywords, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.ExcludeKeywords, "", new { @class = "text-danger" })
                        <small class="form-text text-muted">Virgülle ayrılmış anahtar kelimeler</small>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">
                    <h5 class="mb-0">Durum Ayarları</h5>
                </div>
                <div class="card-body">
                    <div class="form-check mb-2">
                        @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input" })
                        @Html.LabelFor(model => model.IsActive, new { @class = "form-check-label" })
                    </div>

                    <div class="form-check">
                        @Html.CheckBoxFor(model => model.AutoPublish, new { @class = "form-check-input" })
                        @Html.LabelFor(model => model.AutoPublish, new { @class = "form-check-label" })
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Güncelle
                </button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> İptal
                </a>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> İstatistikler</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-6">Durum:</dt>
                    <dd class="col-sm-6">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </dd>

                    <dt class="col-sm-6">Toplam Haber:</dt>
                    <dd class="col-sm-6"><strong>@Model.ItemsFetchedCount</strong></dd>

                    <dt class="col-sm-6">Son Çekilme:</dt>
                    <dd class="col-sm-6">
                        @if (Model.LastFetchedAt.HasValue)
                        {
                            @Model.LastFetchedAt.Value.ToString("dd.MM.yyyy HH:mm")
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>

                    <dt class="col-sm-6">Aralık:</dt>
                    <dd class="col-sm-6">@Model.FetchIntervalMinutes dk</dd>
                </dl>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <p class="small mb-2">
                    <strong>Not:</strong> RSS kaynağını düzenledikten sonra bir sonraki otomatik çekilmede yeni ayarlar kullanılacaktır.
                </p>
                <a href="@Url.Action("Index", "NewsAutomation")" class="btn btn-sm btn-outline-primary w-100">
                    <i class="bi bi-arrow-repeat"></i> Manuel Senkronizasyon Yap
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
