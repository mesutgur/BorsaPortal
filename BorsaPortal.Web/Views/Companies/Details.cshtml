@model BorsaPortal.Domain.Entities.Company

@{
    ViewBag.Title = Model.Code + " - " + Model.Name;
    var priceData = ViewBag.PriceData as BorsaPortal.Application.Services.StockPriceData;
    var isInWatchlist = (bool)ViewBag.IsInWatchlist;
    var portfolioItem = ViewBag.PortfolioItem as BorsaPortal.Domain.Entities.PortfolioItem;
    var recentNews = ViewBag.RecentNews as System.Collections.Generic.List<BorsaPortal.Domain.Entities.News>;
    var recentKap = ViewBag.RecentKap as System.Collections.Generic.List<BorsaPortal.Domain.Entities.KapNotification>;
    var historicalData = ViewBag.HistoricalData as System.Collections.Generic.List<BorsaPortal.Application.Services.HistoricalPriceData>;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Ana Sayfa</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Watchlist")">İzleme Listesi</a></li>
            <li class="breadcrumb-item active">@Model.Code</li>
        </ol>
    </nav>
</div>

<!-- Company Header -->
<div class="row mb-4">
    <div class="col-md-8">
        <h1 class="mb-2">
            <strong>@Model.Code</strong>
            <span class="text-muted fs-4">@Model.Name</span>
        </h1>
        <p class="text-muted mb-0">
            <span class="badge bg-secondary">@(Model.Sector?.Name ?? "N/A")</span>
        </p>
    </div>
    <div class="col-md-4 text-md-end">
        @if (!isInWatchlist)
        {
            <button type="button" class="btn btn-outline-warning mb-2" onclick="addToWatchlist(@Model.Id)">
                <i class="bi bi-star"></i> İzleme Listesine Ekle
            </button>
        }
        else
        {
            <button type="button" class="btn btn-warning mb-2" disabled>
                <i class="bi bi-star-fill"></i> İzleme Listesinde
            </button>
        }
    </div>
</div>

<!-- Price Card & Quick Actions -->
<div class="row mb-4">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                @if (priceData != null && priceData.IsSuccess)
                {
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <h2 class="mb-0">₺@priceData.CurrentPrice.ToString("N2")</h2>
                            <p class="text-muted mb-0">
                                <small>
                                    <i class="bi bi-clock"></i> @priceData.LastUpdate.ToString("HH:mm")
                                </small>
                            </p>
                        </div>
                        <div class="col-md-8">
                            <div class="row text-center">
                                <div class="col-4">
                                    <small class="text-muted d-block">Değişim</small>
                                    <strong class="@(priceData.Change >= 0 ? "text-success" : "text-danger")">
                                        @(priceData.Change >= 0 ? "+" : "")@priceData.Change.ToString("N2")
                                        (@(priceData.ChangePercent >= 0 ? "+" : "")@priceData.ChangePercent.ToString("N2")%)
                                    </strong>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted d-block">Hacim</small>
                                    <strong>@(priceData.Volume?.ToString("N0") ?? "N/A")</strong>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted d-block">İşlem Sayısı</small>
                                    <strong>@(priceData.TradeCount?.ToString("N0") ?? "N/A")</strong>
                                </div>
                            </div>
                            <hr class="my-2" />
                            <div class="row text-center">
                                <div class="col-4">
                                    <small class="text-muted d-block">Gün En Düşük</small>
                                    <strong>@(priceData.DayLow.HasValue ? "₺" + priceData.DayLow.Value.ToString("N2") : "N/A")</strong>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted d-block">Gün En Yüksek</small>
                                    <strong>@(priceData.DayHigh.HasValue ? "₺" + priceData.DayHigh.Value.ToString("N2") : "N/A")</strong>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted d-block">Önceki Kapanış</small>
                                    <strong>@(priceData.PreviousClose.HasValue ? "₺" + priceData.PreviousClose.Value.ToString("N2") : "N/A")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Fiyat bilgisi alınamadı.
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-lightning-charge"></i> Hızlı İşlemler
            </div>
            <div class="card-body">
                @if (portfolioItem != null)
                {
                    <div class="alert alert-info mb-3">
                        <strong><i class="bi bi-briefcase-fill"></i> Portföyünüzde</strong><br />
                        <small>
                            Miktar: @portfolioItem.Quantity.ToString("N2") adet<br />
                            Ort. Alış: ₺@portfolioItem.AverageBuyPrice.ToString("N2")<br />
                            Değer: ₺@portfolioItem.CurrentValue.ToString("N2")
                        </small>
                    </div>
                    <a href="@Url.Action("Index", "Portfolio")" class="btn btn-primary w-100 mb-2">
                        <i class="bi bi-briefcase"></i> Portföye Git
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-success w-100 mb-2" onclick="alert('Portföy sayfasından ekleyebilirsiniz')">
                        <i class="bi bi-plus-circle"></i> Portföye Ekle
                    </button>
                }

                <a href="@Url.Action("Index", "News", new { companyId = Model.Id })" class="btn btn-outline-secondary w-100 mb-2">
                    <i class="bi bi-newspaper"></i> Tüm Haberler
                </a>
                <a href="@Url.Action("Index", "KapNotifications", new { companyId = Model.Id })" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-megaphone"></i> Tüm KAP Bildirimleri
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Price Chart -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div class="mb-2 mb-md-0">
                <h5 class="mb-0 fw-bold">@Model.Code</h5>
                <small class="text-muted">@Model.Name</small>
            </div>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <!-- Chart Type Toggle -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Chart type">
                    <button type="button" class="btn btn-outline-primary active" id="btn-candlestick" onclick="changeChartType('candlestick')">
                        <i class="bi bi-bar-chart-fill"></i> Mum
                    </button>
                    <button type="button" class="btn btn-outline-primary" id="btn-line" onclick="changeChartType('line')">
                        <i class="bi bi-graph-up"></i> Çizgi
                    </button>
                    <button type="button" class="btn btn-outline-primary" id="btn-area" onclick="changeChartType('area')">
                        <i class="bi bi-graph-up-arrow"></i> Alan
                    </button>
                </div>
                <!-- Time Period Buttons -->
                <div class="btn-group btn-group-sm" role="group" aria-label="Time period">
                    <button type="button" class="btn btn-outline-secondary" onclick="changePeriod(7)">1H</button>
                    <button type="button" class="btn btn-outline-secondary active" onclick="changePeriod(30)">1A</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="changePeriod(90)">3A</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="changePeriod(180)">6A</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="changePeriod(365)">1Y</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="changePeriod(1825)">TÜM</button>
                </div>
                <!-- Current Price Display -->
                @if (priceData != null && priceData.IsSuccess)
                {
                    <div class="text-end">
                        <h5 class="mb-0 fw-bold">₺@priceData.CurrentPrice.ToString("N2")</h5>
                        <small class="@(priceData.Change >= 0 ? "text-success" : "text-danger")">
                            @(priceData.Change >= 0 ? "+" : "")@priceData.Change.ToString("N2")
                            (@(priceData.ChangePercent >= 0 ? "+" : "")@priceData.ChangePercent.ToString("N2")%)
                        </small>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <div id="loading-chart" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Grafik yükleniyor...</span>
            </div>
            <p class="text-muted mt-2">Grafik yükleniyor...</p>
        </div>
        <div id="chart-container" style="display:none;">
            <div id="tv-chart" style="height: 500px;"></div>
            <div id="tv-volume" style="height: 100px;"></div>
        </div>
        <div id="error-chart" class="text-center py-5" style="display:none;">
            <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
            <p class="text-muted mt-2">Grafik yüklenirken bir hata oluştu.</p>
        </div>
    </div>
</div>

<!-- News & KAP Tabs -->
<div class="card shadow-sm">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#news-tab" type="button">
                    <i class="bi bi-newspaper"></i> Son Haberler
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#kap-tab" type="button">
                    <i class="bi bi-megaphone"></i> Son KAP Bildirimleri
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content">
            <!-- News Tab -->
            <div class="tab-pane fade show active" id="news-tab">
                @if (recentNews != null && recentNews.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var news in recentNews)
                        {
                            <a href="@Url.Action("Details", "News", new { id = news.Id })" class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@news.Title</h6>
                                    <small class="text-muted">@news.PublishDate.ToString("dd.MM.yyyy")</small>
                                </div>
                                <p class="mb-1 text-muted small">@(news.Summary?.Length > 150 ? news.Summary.Substring(0, 150) + "..." : news.Summary)</p>
                                <small class="text-muted">
                                    <i class="bi bi-tag"></i> @news.Source
                                </small>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p>Henüz haber bulunmuyor.</p>
                    </div>
                }
            </div>

            <!-- KAP Tab -->
            <div class="tab-pane fade" id="kap-tab">
                @if (recentKap != null && recentKap.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var kap in recentKap)
                        {
                            <a href="@Url.Action("Details", "KapNotifications", new { id = kap.Id })" class="list-group-item list-group-item-action">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@kap.Title</h6>
                                    <small class="text-muted">@kap.PublishDate.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                <p class="mb-1 text-muted small">@(kap.Summary?.Length > 150 ? kap.Summary.Substring(0, 150) + "..." : kap.Summary)</p>
                                <small>
                                    <span class="badge bg-info">@kap.NotificationType</span>
                                </small>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p>Henüz KAP bildirimi bulunmuyor.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- TradingView Lightweight Charts -->
    <script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>

    <script type="text/javascript">
        const companyCode = '@Model.Code';
        const companyName = '@Model.Name';

        let chart = null;
        let candlestickSeries = null;
        let lineSeries = null;
        let areaSeries = null;
        let volumeSeries = null;
        let volumeChart = null;
        let currentChartType = 'candlestick';
        let currentPeriod = 30;
        let historicalData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(historicalData ?? new System.Collections.Generic.List<BorsaPortal.Application.Services.HistoricalPriceData>()));

        // Initialize charts when page loads
        document.addEventListener('DOMContentLoaded', function() {
            if (historicalData && historicalData.length > 0) {
                initializeCharts();
                updateChart();
            } else {
                showError();
            }
        });

        function initializeCharts() {
            try {
                // Create main price chart
                chart = LightweightCharts.createChart(document.getElementById('tv-chart'), {
                    layout: {
                        background: { color: '#ffffff' },
                        textColor: '#333',
                    },
                    grid: {
                        vertLines: { color: '#f0f0f0' },
                        horzLines: { color: '#f0f0f0' },
                    },
                    crosshair: {
                        mode: LightweightCharts.CrosshairMode.Normal,
                    },
                    rightPriceScale: {
                        borderColor: '#d1d4dc',
                    },
                    timeScale: {
                        borderColor: '#d1d4dc',
                        timeVisible: true,
                        secondsVisible: false,
                    },
                    localization: {
                        locale: 'tr-TR',
                        priceFormatter: price => '₺' + price.toFixed(2),
                    },
                });

                // Create volume chart
                volumeChart = LightweightCharts.createChart(document.getElementById('tv-volume'), {
                    layout: {
                        background: { color: '#ffffff' },
                        textColor: '#333',
                    },
                    grid: {
                        vertLines: { color: '#f0f0f0' },
                        horzLines: { color: '#f0f0f0' },
                    },
                    rightPriceScale: {
                        borderColor: '#d1d4dc',
                    },
                    timeScale: {
                        borderColor: '#d1d4dc',
                        visible: false,
                    },
                    localization: {
                        locale: 'tr-TR',
                    },
                });

                // Create series for all chart types
                candlestickSeries = chart.addCandlestickSeries({
                    upColor: '#26a69a',
                    downColor: '#ef5350',
                    borderVisible: false,
                    wickUpColor: '#26a69a',
                    wickDownColor: '#ef5350',
                });

                lineSeries = chart.addLineSeries({
                    color: '#2962FF',
                    lineWidth: 2,
                    visible: false,
                });

                areaSeries = chart.addAreaSeries({
                    topColor: 'rgba(41, 98, 255, 0.4)',
                    bottomColor: 'rgba(41, 98, 255, 0.0)',
                    lineColor: '#2962FF',
                    lineWidth: 2,
                    visible: false,
                });

                // Create volume series
                volumeSeries = volumeChart.addHistogramSeries({
                    color: '#26a69a',
                    priceFormat: {
                        type: 'volume',
                    },
                    priceScaleId: '',
                });

                // Handle window resize
                window.addEventListener('resize', () => {
                    if (chart) {
                        chart.applyOptions({ width: document.getElementById('tv-chart').clientWidth });
                    }
                    if (volumeChart) {
                        volumeChart.applyOptions({ width: document.getElementById('tv-volume').clientWidth });
                    }
                });

                // Show chart container
                document.getElementById('loading-chart').style.display = 'none';
                document.getElementById('chart-container').style.display = 'block';

            } catch (error) {
                console.error('Error initializing charts:', error);
                showError();
            }
        }

        function updateChart() {
            try {
                if (!historicalData || historicalData.length === 0) {
                    showError();
                    return;
                }

                // Convert data to TradingView format
                const chartData = historicalData.map(item => ({
                    time: new Date(item.Date).toISOString().split('T')[0],
                    open: item.Open,
                    high: item.High,
                    low: item.Low,
                    close: item.Close,
                })).sort((a, b) => new Date(a.time) - new Date(b.time));

                const volumeData = historicalData.map(item => {
                    const date = new Date(item.Date);
                    const prevClose = historicalData.find(d => new Date(d.Date) < date)?.Close || item.Open;
                    return {
                        time: date.toISOString().split('T')[0],
                        value: item.Volume,
                        color: item.Close >= prevClose ? '#26a69a' : '#ef5350',
                    };
                }).sort((a, b) => new Date(a.time) - new Date(b.time));

                // Update all series data
                candlestickSeries.setData(chartData);
                lineSeries.setData(chartData.map(d => ({ time: d.time, value: d.close })));
                areaSeries.setData(chartData.map(d => ({ time: d.time, value: d.close })));
                volumeSeries.setData(volumeData);

                // Fit content
                chart.timeScale().fitContent();
                volumeChart.timeScale().fitContent();

                // Sync time scales
                chart.timeScale().subscribeVisibleLogicalRangeChange(timeRange => {
                    volumeChart.timeScale().setVisibleLogicalRange(timeRange);
                });

                volumeChart.timeScale().subscribeVisibleLogicalRangeChange(timeRange => {
                    chart.timeScale().setVisibleLogicalRange(timeRange);
                });

            } catch (error) {
                console.error('Error updating chart:', error);
                showError();
            }
        }

        function changeChartType(type) {
            currentChartType = type;

            // Update button states
            document.querySelectorAll('[id^="btn-"]').forEach(btn => btn.classList.remove('active'));
            document.getElementById('btn-' + type).classList.add('active');

            // Update series visibility
            candlestickSeries.applyOptions({ visible: type === 'candlestick' });
            lineSeries.applyOptions({ visible: type === 'line' });
            areaSeries.applyOptions({ visible: type === 'area' });
        }

        function changePeriod(days) {
            currentPeriod = days;

            // Update button states
            document.querySelectorAll('[onclick^="changePeriod"]').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            // Show loading
            document.getElementById('loading-chart').style.display = 'block';
            document.getElementById('chart-container').style.display = 'none';

            // Fetch new data
            fetch('@Url.Action("GetHistoricalData", "Companies")?symbol=' + companyCode + '&days=' + days)
                .then(response => response.json())
                .then(data => {
                    if (data && data.length > 0) {
                        historicalData = data;
                        updateChart();
                        document.getElementById('loading-chart').style.display = 'none';
                        document.getElementById('chart-container').style.display = 'block';
                    } else {
                        showError();
                    }
                })
                .catch(error => {
                    console.error('Error fetching historical data:', error);
                    showError();
                });
        }

        function showError() {
            document.getElementById('loading-chart').style.display = 'none';
            document.getElementById('chart-container').style.display = 'none';
            document.getElementById('error-chart').style.display = 'block';
        }

        function addToWatchlist(companyId) {
            if (confirm('Bu şirketi izleme listenize eklemek istiyor musunuz?')) {
                fetch('@Url.Action("AddToWatchlistAjax", "Watchlist")?companyId=' + companyId, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message || 'Şirket izleme listenize eklendi!');
                        location.reload();
                    } else {
                        alert(data.message || 'Bir hata oluştu.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('İzleme listesine eklenirken bir hata oluştu.');
                });
            }
        }
    </script>
}
