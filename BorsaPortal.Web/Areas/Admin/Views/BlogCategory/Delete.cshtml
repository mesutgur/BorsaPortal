@model BorsaPortal.Web.Areas.Admin.ViewModels.BlogCategoryViewModel

@{
    ViewBag.Title = "Kategori Sil";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Blog Kategorisi Sil</h2>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">Silme Onayı</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Uyarı!</strong> Bu kategoriyi silmek istediğinizden emin misiniz?
                </div>

                @if (Model.PostCount > 0)
                {
                    <div class="alert alert-danger">
                        <strong>Dikkat!</strong> Bu kategoride @Model.PostCount adet yazı bulunmaktadır. Kategoriyi silmeden önce yazıları başka bir kategoriye taşımalısınız.
                    </div>
                }

                <dl class="row">
                    <dt class="col-sm-3">Kategori Adı</dt>
                    <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

                    <dt class="col-sm-3">Slug</dt>
                    <dd class="col-sm-9"><code>@Model.Slug</code></dd>

                    <dt class="col-sm-3">Sıralama</dt>
                    <dd class="col-sm-9">@Model.DisplayOrder</dd>

                    <dt class="col-sm-3">Yazı Sayısı</dt>
                    <dd class="col-sm-9"><span class="badge bg-info">@Model.PostCount</span></dd>

                    <dt class="col-sm-3">Açıklama</dt>
                    <dd class="col-sm-9">@Model.Description</dd>
                </dl>

                @using (Html.BeginForm("Delete", "BlogCategory", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="@Url.Action("Index")" class="btn btn-secondary me-md-2">İptal</a>
                        @if (Model.PostCount == 0)
                        {
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Sil
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger" disabled>
                                <i class="bi bi-trash"></i> Silme Devre Dışı
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
