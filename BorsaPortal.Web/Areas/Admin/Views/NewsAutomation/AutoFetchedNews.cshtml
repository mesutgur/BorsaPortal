@model IEnumerable<BorsaPortal.Domain.Entities.News>

@{
    ViewBag.Title = "Otomatik Çekilen Haberler";
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="bi bi-robot"></i> Otomatik Çekilen Haberler
    </h2>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Panoya Dön
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h5 class="mb-0">Toplam @totalCount Haber</h5>
                <small class="text-muted">RSS feed kaynaklarından otomatik çekilen haberler</small>
            </div>
            <div class="col-md-6 text-md-end">
                <a href="@Url.Action("Index", "News")" class="btn btn-sm btn-primary">
                    <i class="bi bi-newspaper"></i> Tüm Haberleri Gör
                </a>
            </div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        Henüz otomatik çekilen haber bulunmuyor.
        <a href="@Url.Action("Index")" class="alert-link">Haber Otomasyonu Panosu</a>'ndan senkronizasyon yapabilirsiniz.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th style="width: 50%;">Başlık</th>
                            <th>Kaynak</th>
                            <th>Şirket/Sektör</th>
                            <th>Yayın Tarihi</th>
                            <th>Görüntülenme</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var news in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@news.Title</strong>
                                    @if (!string.IsNullOrEmpty(news.Summary))
                                    {
                                        <br />
                                        <small class="text-muted">
                                            @(news.Summary.Length > 100 ? news.Summary.Substring(0, 100) + "..." : news.Summary)
                                        </small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@news.Source</span>
                                    @if (!string.IsNullOrEmpty(news.SourceUrl))
                                    {
                                        <br />
                                        <a href="@news.SourceUrl" target="_blank" class="small">
                                            <i class="bi bi-box-arrow-up-right"></i> Kaynak
                                        </a>
                                    }
                                </td>
                                <td>
                                    @if (news.Company != null)
                                    {
                                        <span class="badge bg-info">@news.Company.Code</span>
                                        <br />
                                    }
                                    @if (news.Sector != null)
                                    {
                                        <span class="badge bg-success">@news.Sector.Name</span>
                                    }
                                    @if (news.Company == null && news.Sector == null)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <small>
                                        @news.PublishDate.ToString("dd.MM.yyyy")
                                        <br />
                                        @news.PublishDate.ToString("HH:mm")
                                    </small>
                                </td>
                                <td>
                                    <span class="badge bg-primary">@news.ViewCount</span>
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", "News", new { id = news.Id })" class="btn btn-sm btn-outline-primary" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (totalPages > 1)
            {
                <nav aria-label="Sayfa navigasyonu" class="mt-3">
                    <ul class="pagination justify-content-center mb-0">
                        @if (currentPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("AutoFetchedNews", new { page = currentPage - 1 })">
                                    Önceki
                                </a>
                            </li>
                        }

                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" href="@Url.Action("AutoFetchedNews", new { page = i })">@i</a>
                            </li>
                        }

                        @if (currentPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("AutoFetchedNews", new { page = currentPage + 1 })">
                                    Sonraki
                                </a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>

    <div class="alert alert-light mt-3">
        <i class="bi bi-info-circle"></i>
        <strong>Bilgi:</strong> Bu sayfada sadece otomatik çekilen haberler gösterilmektedir.
        Tüm haberleri görmek için <a href="@Url.Action("Index", "News")" class="alert-link">Haberler</a> sayfasını ziyaret edin.
    </div>
}
