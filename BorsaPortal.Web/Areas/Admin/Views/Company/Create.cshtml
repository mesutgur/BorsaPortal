@model BorsaPortal.Web.Areas.Admin.ViewModels.CompanyViewModel

@{
    ViewBag.Title = "Yeni Şirket Ekle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Yeni Şirket Ekle</h2>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>
</div>

<div class="row">
    <div class="col-md-10">
        <div class="card">
            <div class="card-body">
                @using (Html.BeginForm("Create", "Company", FormMethod.Post, new { @class = "needs-validation" }))
