<!DOCTYPE html>
<html lang="tr">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Borsa Portal Yönetim Paneli</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        body {
            background-color: #f8f9fa;
        }
        .sidebar {
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding: 56px 0 0;
            box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
            background-color: #212529;
            width: 250px;
        }
        .sidebar-sticky {
            position: relative;
            top: 0;
            height: calc(100vh - 56px);
            padding-top: .5rem;
            overflow-x: hidden;
            overflow-y: auto;
        }
        .sidebar .nav-link {
            font-weight: 500;
            color: #adb5bd;
            padding: 0.75rem 1rem;
        }
        .sidebar .nav-link:hover {
            color: #ffffff;
            background-color: #343a40;
        }
        .sidebar .nav-link.active {
            color: #ffffff;
            background-color: #0d6efd;
        }
        .sidebar .nav-link i {
            margin-right: 8px;
        }
        .main-content {
            margin-left: 250px;
            padding: 20px;
        }
        .navbar {
            padding-left: 250px;
        }
        .card {
            box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
            margin-bottom: 1.5rem;
        }
    </style>
</head>
<body>
    <!-- Top Navigation -->
    <nav class="navbar navbar-dark bg-dark fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                <strong>Borsa Portal</strong> Yönetim
            </a>
            <div class="d-flex">
                <span class="navbar-text me-3 text-light">
                    Hoş geldin, @ViewBag.CurrentUser
                </span>
                <a href="@Url.Action("Index", "Home", new { area = "" })" class="btn btn-outline-light btn-sm me-2">
                    Siteyi Görüntüle
                </a>
                <a href="@Url.Action("LogOff", "Account", new { area = "" })" class="btn btn-outline-danger btn-sm">
                    Çıkış Yap
                </a>
            </div>
        </div>
    </nav>

    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="sidebar-sticky">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Dashboard", new { area = "Admin" })">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>

                <li class="nav-item mt-3">
                    <h6 class="px-3 text-uppercase text-muted small">İçerik Yönetimi</h6>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Company", new { area = "Admin" })">
                        <i class="bi bi-building"></i> Şirketler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "Sector", new { area = "Admin" })">
                        <i class="bi bi-diagram-3"></i> Sektörler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "KapNotification", new { area = "Admin" })">
                        <i class="bi bi-newspaper"></i> KAP Bildirimleri
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "News", new { area = "Admin" })">
                        <i class="bi bi-file-text"></i> Haberler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "BlogCategory", new { area = "Admin" })">
                        <i class="bi bi-folder"></i> Blog Kategorileri
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "BlogPost", new { area = "Admin" })">
                        <i class="bi bi-journal-text"></i> Blog Yazıları
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-chat-dots"></i> Yorumlar
                    </a>
                </li>

                <li class="nav-item mt-3">
                    <h6 class="px-3 text-uppercase text-muted small">Otomasyon</h6>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "NewsAutomation", new { area = "Admin" })">
                        <i class="bi bi-robot"></i> Haber Otomasyonu
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "RssFeedSource", new { area = "Admin" })">
                        <i class="bi bi-rss-fill"></i> RSS Kaynakları
                    </a>
                </li>

                <li class="nav-item mt-3">
                    <h6 class="px-3 text-uppercase text-muted small">Finansal Veri</h6>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-graph-up"></i> Finansal Dönemler
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-currency-dollar"></i> Fiyat Verileri
                    </a>
                </li>

                <li class="nav-item mt-3">
                    <h6 class="px-3 text-uppercase text-muted small">Kullanıcı Yönetimi</h6>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-people"></i> Kullanıcılar
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-credit-card"></i> Abonelikler
                    </a>
                </li>

                <li class="nav-item mt-3">
                    <h6 class="px-3 text-uppercase text-muted small">Sistem</h6>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Index", "ValuationMethod", new { area = "Admin" })">
                        <i class="bi bi-calculator"></i> Değerleme Yöntemleri
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">
                        <i class="bi bi-gear"></i> Ayarlar
                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="main-content" style="margin-top: 56px;">
        <div class="container-fluid">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <strong>Başarılı!</strong> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Hata!</strong>
                    <pre style="background: transparent; border: none; color: inherit; margin: 0; padding: 0; white-space: pre-wrap;">@TempData["ErrorMessage"]</pre>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["WarningMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <strong>Uyarı!</strong> @TempData["WarningMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <strong>Bilgi!</strong> @TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @RenderBody()
        </div>
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
