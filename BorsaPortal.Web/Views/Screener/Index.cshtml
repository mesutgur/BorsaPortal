@model List<BorsaPortal.Web.Controllers.ScreenerResult>

@{
    ViewBag.Title = "Hisse Tarayıcı (Screener)";
    var sectors = ViewBag.Sectors as List<BorsaPortal.Domain.Entities.Sector> ?? new List<BorsaPortal.Domain.Entities.Sector>();
    var filter = ViewBag.Filter as BorsaPortal.Web.Controllers.ScreenerFilter ?? new BorsaPortal.Web.Controllers.ScreenerFilter();
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="mb-2">
                <i class="bi bi-funnel"></i> Hisse Tarayıcı (Screener)
            </h1>
            <p class="text-muted">Teknik göstergelere ve kriterlere göre hisse senedi tarama</p>
        </div>
    </div>

    <!-- Filter Panel -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-sliders"></i> Filtreler
            </h5>
        </div>
        <div class="card-body">
            <form method="get" action="@Url.Action("Index")" id="screenerForm">
                <div class="row g-3">
                    <!-- Sector -->
                    <div class="col-md-4">
                        <label for="sectorId" class="form-label">
                            <i class="bi bi-diagram-3"></i> Sektör
                        </label>
                        <select class="form-select" id="sectorId" name="sectorId">
                            <option value="">Tüm Sektörler</option>
                            @foreach (var sector in sectors)
                            {
                                <option value="@sector.Id" @(filter.SectorId == sector.Id ? "selected" : "")>
                                    @sector.Name
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Price Range -->
                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="bi bi-cash"></i> Fiyat Aralığı (₺)
                        </label>
                        <div class="input-group">
                            <input type="number" class="form-control" name="minPrice" placeholder="Min"
                                   value="@filter.MinPrice" step="0.01">
                            <span class="input-group-text">-</span>
                            <input type="number" class="form-control" name="maxPrice" placeholder="Max"
                                   value="@filter.MaxPrice" step="0.01">
                        </div>
                    </div>

                    <!-- Volume -->
                    <div class="col-md-4">
                        <label for="minVolume" class="form-label">
                            <i class="bi bi-bar-chart"></i> Min. Hacim
                        </label>
                        <input type="number" class="form-control" id="minVolume" name="minVolume"
                               value="@filter.MinVolume" placeholder="Örn: 1000000">
                    </div>

                    <!-- Change Percent -->
                    <div class="col-md-4">
                        <label class="form-label">
                            <i class="bi bi-graph-up"></i> Değişim Aralığı (%)
                        </label>
                        <div class="input-group">
                            <input type="number" class="form-control" name="minChangePercent" placeholder="Min"
                                   value="@filter.MinChangePercent" step="0.01">
                            <span class="input-group-text">-</span>
                            <input type="number" class="form-control" name="maxChangePercent" placeholder="Max"
                                   value="@filter.MaxChangePercent" step="0.01">
                        </div>
                    </div>

                    <!-- Quick Filters -->
                    <div class="col-md-4">
                        <label class="form-label">Hızlı Filtreler</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="gainersOnly" id="gainersOnly"
                                   value="true" @(filter.GainersOnly ? "checked" : "")>
                            <label class="form-check-label" for="gainersOnly">
                                <i class="bi bi-arrow-up-circle text-success"></i> Sadece Yükselenler
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="losersOnly" id="losersOnly"
                                   value="true" @(filter.LosersOnly ? "checked" : "")>
                            <label class="form-check-label" for="losersOnly">
                                <i class="bi bi-arrow-down-circle text-danger"></i> Sadece Düşenler
                            </label>
                        </div>
                    </div>

                    <!-- Sort By -->
                    <div class="col-md-4">
                        <label for="sortBy" class="form-label">
                            <i class="bi bi-sort-down"></i> Sıralama
                        </label>
                        <select class="form-select" id="sortBy" name="sortBy">
                            <option value="changePercent" @(filter.SortBy == "changePercent" ? "selected" : "")>Değişim (%)</option>
                            <option value="volume" @(filter.SortBy == "volume" ? "selected" : "")>Hacim</option>
                            <option value="price" @(filter.SortBy == "price" ? "selected" : "")>Fiyat</option>
                            <option value="code" @(filter.SortBy == "code" ? "selected" : "")>Kod</option>
                            <option value="name" @(filter.SortBy == "name" ? "selected" : "")>İsim</option>
                        </select>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-funnel"></i> Tara
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Temizle
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Summary -->
    @if (Model != null && Model.Any())
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Bulunan Hisse</h6>
                        <h3 class="mb-0">@Model.Count</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Yükselenler</h6>
                        <h3 class="mb-0 text-success">@Model.Count(r => r.ChangePercent > 0)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-start border-danger border-3">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Düşenler</h6>
                        <h3 class="mb-0 text-danger">@Model.Count(r => r.ChangePercent < 0)</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-start border-info border-3">
                    <div class="card-body">
                        <h6 class="text-muted mb-1">Ort. Değişim</h6>
                        <h3 class="mb-0">
                            <span class="@(Model.Average(r => r.ChangePercent) >= 0 ? "text-success" : "text-danger")">
                                @Model.Average(r => r.ChangePercent).ToString("N2")%
                            </span>
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Results Table -->
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-list-check"></i> Tarama Sonuçları
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="ps-3">Sıra</th>
                                <th>Kod</th>
                                <th>Şirket</th>
                                <th>Sektör</th>
                                <th class="text-end">Fiyat</th>
                                <th class="text-end">Değişim</th>
                                <th class="text-end">Değişim %</th>
                                <th class="text-end">Hacim</th>
                                <th class="text-end">Gün Düşük</th>
                                <th class="text-end">Gün Yüksek</th>
                                <th class="text-center">Aksiyon</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var result = Model[i];
                                var rowClass = result.ChangePercent >= 0 ? "table-success-subtle" : "table-danger-subtle";

                                <tr class="@rowClass">
                                    <td class="ps-3"><strong>#@(i + 1)</strong></td>
                                    <td>
                                        <strong>@result.Company.Code</strong>
                                    </td>
                                    <td>
                                        <span class="text-muted small">@result.Company.Name</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@(result.Company.Sector?.Name ?? "N/A")</span>
                                    </td>
                                    <td class="text-end">
                                        <strong>₺@result.CurrentPrice.ToString("N2")</strong>
                                    </td>
                                    <td class="text-end">
                                        <span class="@(result.Change >= 0 ? "text-success" : "text-danger")">
                                            @(result.Change >= 0 ? "+" : "")@result.Change.ToString("N2")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <strong class="@(result.ChangePercent >= 0 ? "text-success" : "text-danger")">
                                            <i class="bi bi-@(result.ChangePercent >= 0 ? "arrow-up" : "arrow-down")-circle-fill"></i>
                                            @(result.ChangePercent >= 0 ? "+" : "")@result.ChangePercent.ToString("N2")%
                                        </strong>
                                    </td>
                                    <td class="text-end">
                                        <small class="text-muted">@result.Volume.ToString("N0")</small>
                                    </td>
                                    <td class="text-end">
                                        <small>₺@result.DayLow.ToString("N2")</small>
                                    </td>
                                    <td class="text-end">
                                        <small>₺@result.DayHigh.ToString("N2")</small>
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Details", "Companies", new { id = result.Company.Id })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Detay
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-search fs-1"></i>
            <h4 class="mt-3">Sonuç bulunamadı</h4>
            <p class="text-muted">Arama kriterlerinize uygun hisse senedi bulunamadı. Lütfen filtrelerinizi ayarlayın ve tekrar deneyin.</p>
        </div>
    }
</div>

@section Styles {
    <style>
        .table-success-subtle {
            background-color: rgba(40, 167, 69, 0.05);
        }

        .table-danger-subtle {
            background-color: rgba(220, 53, 69, 0.05);
        }

        .table tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.03) !important;
        }

        .sticky-top {
            position: sticky;
            top: 0;
            z-index: 10;
            background-color: #f8f9fa;
        }

        .form-check-input:checked {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Prevent both gainers and losers being selected
            $('#gainersOnly').on('change', function() {
                if (this.checked) {
                    $('#losersOnly').prop('checked', false);
                }
            });

            $('#losersOnly').on('change', function() {
                if (this.checked) {
                    $('#gainersOnly').prop('checked', false);
                }
            });

            // Auto-submit on sort change
            $('#sortBy').on('change', function() {
                $('#screenerForm').submit();
            });
        });
    </script>
}
