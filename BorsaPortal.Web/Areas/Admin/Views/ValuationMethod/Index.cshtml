@model IEnumerable<BorsaPortal.Domain.Entities.ValuationMethod>
@{
    ViewBag.Title = "Değerleme Yöntemleri Yönetimi";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-calculator-fill"></i> Değerleme Yöntemleri</h2>
        <a href="@Url.Action("Create")" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Yeni Yöntem Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Tüm Değerleme Yöntemleri</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Sıra</th>
                                <th>Yöntem Adı</th>
                                <th>Yöntem Tipi</th>
                                <th>Açıklama</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var method in Model.OrderBy(m => m.DisplayOrder))
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">@method.DisplayOrder</span>
                                    </td>
                                    <td>
                                        <strong>@method.Name</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@method.MethodType</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(method.Description))
                                        {
                                            if (method.Description.Length > 100)
                                            {
                                                <span>@method.Description.Substring(0, 100)...</span>
                                            }
                                            else
                                            {
                                                <span>@method.Description</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (method.IsActive)
                                        {
                                            <span class="badge bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Pasif</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Edit", new { id = method.Id })"
                                               class="btn btn-sm btn-warning"
                                               title="Düzenle">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-sm btn-danger delete-btn"
                                                    data-id="@method.Id"
                                                    data-name="@method.Name"
                                                    title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calculator-fill" style="font-size: 4rem; color: #ccc;"></i>
                    <h4 class="mt-3 text-muted">Henüz değerleme yöntemi yok</h4>
                    <p class="text-muted">İlk değerleme yöntemini oluşturun!</p>
                    <a href="@Url.Action("Create")" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Yeni Yöntem Ekle
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="card mt-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0"><i class="bi bi-info-circle"></i> Yöntem Tipleri Hakkında</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>Basic:</strong> Temel F/K oranı analizi</li>
                        <li class="mb-2"><strong>Quarter1:</strong> İlk çeyrek verileriyle analiz</li>
                        <li class="mb-2"><strong>Quarter2:</strong> İkinci çeyrek (6 aylık) verileriyle analiz</li>
                        <li class="mb-2"><strong>Quarter3:</strong> Üçüncü çeyrek (9 aylık) verileriyle analiz</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>Quarter4:</strong> Dördüncü çeyrek (yıllık) verileriyle analiz</li>
                        <li class="mb-2"><strong>YearEnd:</strong> Yıl sonu tahmini analizi</li>
                        <li class="mb-2"><strong>LongTerm:</strong> Uzun vadeli hedef fiyat (2019-2022 historik verileri)</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    @Scripts.Render("~/bundles/jquery")
    <script>
        $(document).ready(function () {
            // Delete butonu
            $('.delete-btn').on('click', function () {
                var id = $(this).data('id');
                var name = $(this).data('name');

                if (confirm('\"' + name + '\" değerleme yöntemini silmek istediğinizden emin misiniz?')) {
                    $.ajax({
                        url: '@Url.Action("Delete", "ValuationMethod")',
                        type: 'POST',
                        data: {
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert('Hata: ' + response.message);
                            }
                        },
                        error: function () {
                            alert('Silme işlemi sırasında bir hata oluştu.');
                        }
                    });
                }
            });
        });
    </script>
    @Html.AntiForgeryToken()
}
