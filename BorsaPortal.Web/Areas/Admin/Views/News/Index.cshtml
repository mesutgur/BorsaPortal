@model IEnumerable<BorsaPortal.Domain.Entities.News>

@{
    ViewBag.Title = "Haber Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Haber Yönetimi</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Yeni Haber Ekle
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Şirket</label>
                @Html.DropDownList("companyId", (SelectList)ViewBag.Companies, "-- Tüm Şirketler --", new { @class = "form-select" })
            </div>
            <div class="col-md-4">
                <label class="form-label">Sektör</label>
                @Html.DropDownList("sectorId", (SelectList)ViewBag.Sectors, "-- Tüm Sektörler --", new { @class = "form-select" })
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="bi bi-funnel"></i> Filtrele
                </button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> Temizle
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Yayın Tarihi</th>
                            <th>Başlık</th>
                            <th>Kaynak</th>
                            <th>Şirket</th>
                            <th>Sektör</th>
                            <th>Öne Çıkan</th>
                            <th>Görüntülenme</th>
                            <th style="width: 100px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.PublishDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrEmpty(item.Summary))
                                    {
                                        <br />
                                        <small class="text-muted">@(item.Summary.Length > 100 ? item.Summary.Substring(0, 100) + "..." : item.Summary)</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Source))
                                    {
                                        @item.Source
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Company != null)
                                    {
                                        <span class="badge bg-info">@item.Company.Code</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Sector != null)
                                    {
                                        <span class="badge bg-secondary">@item.Sector.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsFeatured)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-star-fill"></i> Evet
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Hayır</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary">@item.ViewCount</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Düzenle
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu haberi silmek istediğinizden emin misiniz?');">
                                            <i class="bi bi-trash"></i> Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Henüz haber kaydı bulunmamaktadır.
    </div>
}
