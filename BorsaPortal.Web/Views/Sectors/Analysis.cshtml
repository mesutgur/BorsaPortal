@model List<BorsaPortal.Web.Controllers.SectorPerformanceViewModel>

@{
    ViewBag.Title = "Sektörel Analiz";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Ana Sayfa</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Sectors")">Sektörler</a></li>
                    <li class="breadcrumb-item active">Sektörel Analiz</li>
                </ol>
            </nav>
            <h1 class="mb-2">
                <i class="bi bi-graph-up-arrow"></i> Sektörel Performans Analizi
            </h1>
            <p class="text-muted">Sektörlerin günlük performans karşılaştırması</p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <!-- Summary Cards -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm border-start border-primary border-3">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">En İyi Performans</h6>
                        <h4 class="mb-0 text-success">@Model.First().SectorName</h4>
                        <small class="text-success">
                            <i class="bi bi-arrow-up"></i> %@Model.First().AverageChange.ToString("N2")
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-start border-danger border-3">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">En Düşük Performans</h6>
                        <h4 class="mb-0 text-danger">@Model.Last().SectorName</h4>
                        <small class="text-danger">
                            <i class="bi bi-arrow-down"></i> %@Model.Last().AverageChange.ToString("N2")
                        </small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-start border-success border-3">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">Toplam Sektör</h6>
                        <h4 class="mb-0">@Model.Count</h4>
                        <small class="text-muted">Analiz edilen sektör</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm border-start border-info border-3">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">Son Güncelleme</h6>
                        <h4 class="mb-0">@DateTime.Now.ToString("HH:mm")</h4>
                        <small class="text-muted">@DateTime.Now.ToString("dd MMM yyyy")</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Performance Chart -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-bar-chart-fill"></i> Sektör Performans Grafiği
                </h5>
            </div>
            <div class="card-body">
                <canvas id="sectorChart" style="height: 400px;"></canvas>
            </div>
        </div>

        <!-- Performance Table -->
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-table"></i> Detaylı Sektör Performansı
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Sıra</th>
                                <th>Sektör</th>
                                <th class="text-center">Şirket Sayısı</th>
                                <th class="text-end">Ortalama Değişim</th>
                                <th class="text-center">Yükselen</th>
                                <th class="text-center">Düşen</th>
                                <th class="text-end">Toplam İşlem Hacmi</th>
                                <th class="text-center">Aksiyon</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var sector = Model[i];
                                var rowClass = sector.AverageChange >= 0 ? "table-success-subtle" : "table-danger-subtle";

                                <tr class="@rowClass">
                                    <td class="ps-3">
                                        <strong>#@(i + 1)</strong>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", new { id = sector.SectorId })" class="text-decoration-none">
                                            <strong>@sector.SectorName</strong>
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary">@sector.CompanyCount</span>
                                    </td>
                                    <td class="text-end">
                                        <strong class="@(sector.AverageChange >= 0 ? "text-success" : "text-danger")">
                                            <i class="bi bi-@(sector.AverageChange >= 0 ? "arrow-up" : "arrow-down")-circle-fill"></i>
                                            @(sector.AverageChange >= 0 ? "+" : "")@sector.AverageChange.ToString("N2")%
                                        </strong>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success">
                                            <i class="bi bi-arrow-up"></i> @sector.PositiveStockCount
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-danger">
                                            <i class="bi bi-arrow-down"></i> @sector.NegativeStockCount
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <small class="text-muted">@sector.TotalVolume.ToString("N0")</small>
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Details", new { id = sector.SectorId })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Detay
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-info-circle fs-1"></i>
            <h4 class="mt-3">Sektör verisi bulunamadı</h4>
            <p class="text-muted">Şu anda analiz edilebilecek sektör verisi bulunmuyor.</p>
        </div>
    }
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

    <script>
        @if (Model != null && Model.Any())
        {
            <text>
            // Prepare data for chart
            var sectorNames = [@Html.Raw(string.Join(",", Model.Select(s => "'" + s.SectorName + "'")))];
            var sectorChanges = [@Html.Raw(string.Join(",", Model.Select(s => s.AverageChange.ToString("F2", System.Globalization.CultureInfo.InvariantCulture))))];

            // Create gradient colors
            var backgroundColors = sectorChanges.map(change =>
                change >= 0 ? 'rgba(40, 167, 69, 0.7)' : 'rgba(220, 53, 69, 0.7)'
            );
            var borderColors = sectorChanges.map(change =>
                change >= 0 ? 'rgba(40, 167, 69, 1)' : 'rgba(220, 53, 69, 1)'
            );

            // Create chart
            var ctx = document.getElementById('sectorChart').getContext('2d');
            var sectorChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: sectorNames,
                    datasets: [{
                        label: 'Ortalama Değişim (%)',
                        data: sectorChanges,
                        backgroundColor: backgroundColors,
                        borderColor: borderColors,
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Değişim: ' + (context.parsed.y >= 0 ? '+' : '') + context.parsed.y.toFixed(2) + '%';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)'
                            },
                            ticks: {
                                callback: function(value) {
                                    return value + '%';
                                }
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}

@section Styles {
    <style>
        .table-success-subtle {
            background-color: rgba(40, 167, 69, 0.05);
        }

        .table-danger-subtle {
            background-color: rgba(220, 53, 69, 0.05);
        }

        .table tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.03) !important;
        }
    </style>
}
