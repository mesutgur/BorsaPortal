@model BorsaPortal.Domain.Entities.MarketIndex

@{
    ViewBag.Title = "Piyasa Endeksi Sil";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Piyasa Endeksi Sil</h2>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Silme Onayı</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <strong>Uyarı:</strong> Bu işlem geri alınamaz. Endeksi silmek istediğinizden emin misiniz?
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Endeks Kodu</dt>
                    <dd class="col-sm-9">@Model.Code</dd>

                    <dt class="col-sm-3">Endeks Adı</dt>
                    <dd class="col-sm-9">@Model.Name</dd>

                    <dt class="col-sm-3">Açıklama</dt>
                    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</dd>

                    <dt class="col-sm-3">Güncel Değer</dt>
                    <dd class="col-sm-9">@(Model.CurrentValue.HasValue ? Model.CurrentValue.Value.ToString("N2") : "-")</dd>

                    <dt class="col-sm-3">Ortalama F/K</dt>
                    <dd class="col-sm-9">@(Model.AveragePE.HasValue ? Model.AveragePE.Value.ToString("N2") : "-")</dd>

                    <dt class="col-sm-3">Ortalama PD/DD</dt>
                    <dd class="col-sm-9">@(Model.AveragePB.HasValue ? Model.AveragePB.Value.ToString("N2") : "-")</dd>
                </dl>

                @using (Html.BeginForm("Delete", "MarketIndex", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.Id)

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="@Url.Action("Index")" class="btn btn-secondary me-md-2">İptal</a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Sil
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
