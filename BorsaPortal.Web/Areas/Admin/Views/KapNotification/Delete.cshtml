@model BorsaPortal.Domain.Entities.KapNotification

@{
    ViewBag.Title = "KAP Bildirimi Sil";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>KAP Bildirimi Sil</h2>
    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Geri Dön
    </a>
</div>

<div class="alert alert-warning" role="alert">
    <i class="bi bi-exclamation-triangle-fill"></i>
    <strong>Dikkat!</strong> Bu kaydı silmek istediğinizden emin misiniz?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Şirket</dt>
            <dd class="col-sm-9">@Model.Company.Code - @Model.Company.Name</dd>

            <dt class="col-sm-3">Bildirim Numarası</dt>
            <dd class="col-sm-9">@Model.NotificationNumber</dd>

            <dt class="col-sm-3">Başlık</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3">Bildirim Türü</dt>
            <dd class="col-sm-9">
                @switch (Model.NotificationType)
                {
                    case BorsaPortal.Domain.Enums.KapNotificationType.FinancialStatement:
                        <span class="badge bg-info">Mali Tablo</span>
                        break;
                    case BorsaPortal.Domain.Enums.KapNotificationType.GeneralAssembly:
                        <span class="badge bg-primary">Genel Kurul</span>
                        break;
                    case BorsaPortal.Domain.Enums.KapNotificationType.OwnershipStructure:
                        <span class="badge bg-secondary">Ortaklık Yapısı</span>
                        break;
                    case BorsaPortal.Domain.Enums.KapNotificationType.MaterialDisclosure:
                        <span class="badge bg-danger">Özel Durum Açıklaması</span>
                        break;
                    case BorsaPortal.Domain.Enums.KapNotificationType.Dividend:
                        <span class="badge bg-success">Kar Payı</span>
                        break;
                    case BorsaPortal.Domain.Enums.KapNotificationType.BoardDecision:
                        <span class="badge bg-warning text-dark">Yönetim Kurulu Kararı</span>
                        break;
                    case BorsaPortal.Domain.Enums.KapNotificationType.CapitalIncrease:
                        <span class="badge bg-primary">Sermaye Artırımı</span>
                        break;
                    case BorsaPortal.Domain.Enums.KapNotificationType.MergerAcquisition:
                        <span class="badge bg-danger">Birleşme/Devralma</span>
                        break;
                    case BorsaPortal.Domain.Enums.KapNotificationType.Related:
                        <span class="badge bg-secondary">İlişkili Taraf İşlemleri</span>
                        break;
                    default:
                        <span class="badge bg-dark">Diğer</span>
                        break;
                }
            </dd>

            <dt class="col-sm-3">Yayın Tarihi</dt>
            <dd class="col-sm-9">@Model.PublishDate.ToString("dd.MM.yyyy HH:mm")</dd>

            <dt class="col-sm-3">Özet</dt>
            <dd class="col-sm-9">@Model.Summary</dd>

            @if (!string.IsNullOrEmpty(Model.SourceUrl))
            {
                <dt class="col-sm-3">Kaynak URL</dt>
                <dd class="col-sm-9">
                    <a href="@Model.SourceUrl" target="_blank" class="text-decoration-none">
                        @Model.SourceUrl <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </dd>
            }

            <dt class="col-sm-3">Oluşturulma</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
        </dl>

        @using (Html.BeginForm("Delete", "KapNotification", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.Id)

            <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                <a href="@Url.Action("Index")" class="btn btn-secondary me-md-2">İptal</a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Sil
                </button>
            </div>
        }
    </div>
</div>
