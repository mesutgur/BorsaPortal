@model IEnumerable<BorsaPortal.Domain.Entities.Company>

@{
    ViewBag.Title = "Şirketler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Şirketler</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Yeni Şirket Ekle
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kod</th>
                            <th>Şirket Adı</th>
                            <th>Sektör</th>
                            <th>Ödenmiş Sermaye</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.Code</strong></td>
                                <td>@item.Name</td>
                                <td>@(item.Sector != null ? item.Sector.Name : "-")</td>
                                <td>@(item.PaidInCapital.HasValue ? item.PaidInCapital.Value.ToString("N0") : "-")</td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                Henüz şirket eklenmemiş. <a href="@Url.Action("Create")">Yeni şirket ekle</a>
            </div>
        }
    </div>
</div>
