@model BorsaPortal.Web.ViewModels.ValuationIndexViewModel
@{
    ViewBag.Title = "Hisse Değerlemelerim";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-calculator"></i> Hisse Değerlemelerim</h2>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Yeni Değerleme
                </a>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- İstatistikler -->
            @if (Model.Statistics != null && Model.Statistics.Count > 0)
            {
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="card bg-primary text-white">
                            <div class="card-body">
                                <h5 class="card-title">Toplam Değerleme</h5>
                                <h2 class="mb-0">@(Model.Statistics.ContainsKey("TotalValuations") ? Model.Statistics["TotalValuations"] : 0)</h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success text-white">
                            <div class="card-body">
                                <h5 class="card-title">Ort. Prim Potansiyeli</h5>
                                <h2 class="mb-0">
                                    @if (Model.Statistics.ContainsKey("AveragePremium"))
                                    {
                                        string.Format("{0:N2}%", Model.Statistics["AveragePremium"]);
                                    }
                                    else
                                    {
                                        @:-%
                                    }
                                </h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-info text-white">
                            <div class="card-body">
                                <h5 class="card-title">En Yüksek Hedef</h5>
                                <h2 class="mb-0">
                                    @if (Model.Statistics.ContainsKey("HighestTarget"))
                                    {
                                        string.Format("₺{0:N2}", Model.Statistics["HighestTarget"]);
                                    }
                                    else
                                    {
                                        @:-
                                    }
                                </h2>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-warning text-dark">
                            <div class="card-body">
                                <h5 class="card-title">Bu Ay</h5>
                                <h2 class="mb-0">@(Model.Statistics.ContainsKey("MonthlyValuations") ? Model.Statistics["MonthlyValuations"] : 0)</h2>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Değerleme Listesi -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Değerleme Geçmişi</h5>
                </div>
                <div class="card-body">
                    @if (Model.Valuations != null && Model.Valuations.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Tarih</th>
                                        <th>Şirket</th>
                                        <th>Yöntem</th>
                                        <th class="text-end">Güncel Fiyat</th>
                                        <th class="text-end">Hedef Fiyat</th>
                                        <th class="text-end">Prim Potansiyeli</th>
                                        <th class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var valuation in Model.Valuations)
                                    {
                                        <tr>
                                            <td>@valuation.ValuationDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                            <td>
                                                @if (valuation.Company != null)
                                                {
                                                    <strong>@valuation.Company.Code</strong>
                                                    <br />
                                                    <small class="text-muted">@valuation.Company.Name</small>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td>
                                                @if (valuation.ValuationMethod != null)
                                                {
                                                    <span class="badge bg-secondary">@valuation.ValuationMethod.Name</span>
                                                }
                                            </td>
                                            <td class="text-end">₺@string.Format("{0:N2}", valuation.CurrentPrice)</td>
                                            <td class="text-end">
                                                @if (valuation.TargetPrice.HasValue)
                                                {
                                                    <strong>₺@string.Format("{0:N2}", valuation.TargetPrice.Value)</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (valuation.PremiumPotential.HasValue)
                                                {
                                                    var premium = valuation.PremiumPotential.Value;
                                                    var badgeClass = premium > 0 ? "bg-success" : (premium < 0 ? "bg-danger" : "bg-secondary");
                                                    <span class="badge @badgeClass">
                                                        @string.Format("{0:+0.00;-0.00;0}%", premium)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <a href="@Url.Action("Details", new { id = valuation.Id })"
                                                   class="btn btn-sm btn-info" title="Detayları Görüntüle">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                @using (Html.BeginForm("Delete", "Valuation", new { id = valuation.Id }, FormMethod.Post, new { @class = "d-inline", id = "deleteForm" + valuation.Id }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger"
                                                            onclick="return confirm('Bu değerlemeyi silmek istediğinizden emin misiniz?');"
                                                            title="Sil">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calculator" style="font-size: 4rem; color: #ccc;"></i>
                            <h4 class="mt-3 text-muted">Henüz değerleme kaydınız yok</h4>
                            <p class="text-muted">Hemen ilk değerlemenizi oluşturun!</p>
                            <a href="@Url.Action("Create")" class="btn btn-primary mt-2">
                                <i class="bi bi-plus-circle"></i> Yeni Değerleme Oluştur
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}
