@model IEnumerable<BorsaPortal.Domain.Entities.Sector>

@{
    ViewBag.Title = "Sektörler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Sektörler</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Yeni Sektör Ekle
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kod</th>
                            <th>Sektör Adı</th>
                            <th>Ort. F/K</th>
                            <th>Ort. PD/DD</th>
                            <th>Açıklama</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@(item.AveragePE.HasValue ? item.AveragePE.Value.ToString("N2") : "-")</td>
                                <td>@(item.AveragePB.HasValue ? item.AveragePB.Value.ToString("N2") : "-")</td>
                                <td>@(item.Description != null && item.Description.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                Henüz sektör eklenmemiş. <a href="@Url.Action("Create")">Yeni sektör ekle</a>
            </div>
        }
    </div>
</div>
