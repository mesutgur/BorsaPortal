@using BorsaPortal.Application.Services
@{
    ViewBag.Title = "Gelişmiş Analiz";
    var portfolioSummary = ViewBag.PortfolioSummary as PortfolioSummary;
    var diversification = ViewBag.Diversification as Dictionary<string, object>;
    var riskMetrics = ViewBag.RiskMetrics as Dictionary<string, object>;
    var sectorConcentration = ViewBag.SectorConcentration as dynamic;
    var topHoldings = ViewBag.TopHoldings as dynamic;
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2><i class="bi bi-graph-up-arrow"></i> Gelişmiş Portföy Analizi</h2>
                <p class="text-muted">Risk metrikleri, çeşitlendirme analizi ve detaylı raporlar</p>
            </div>
            <div>
                <a href="@Url.Action("Comparison", "AdvancedAnalytics")" class="btn btn-info me-2">
                    <i class="bi bi-arrow-left-right"></i> Hisse Karşılaştır
                </a>
                <a href="@Url.Action("PerformanceTrends", "AdvancedAnalytics")" class="btn btn-success me-2">
                    <i class="bi bi-graph-up"></i> Performans Trendleri
                </a>
                <a href="@Url.Action("Index", "Portfolio")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Portföy'e Dön
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Diversification Score Card -->
@if (diversification != null && diversification.Any())
{
    var diversificationScore = (decimal)diversification["DiversificationScore"];
    var scoreColor = diversificationScore >= 70 ? "success" : diversificationScore >= 50 ? "warning" : "danger";

    <div class="card mb-4 border-@scoreColor">
        <div class="card-header bg-@scoreColor text-white">
            <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Portföy Çeşitlendirme Skoru</h5>
        </div>
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-3 text-center">
                    <div class="display-1 fw-bold text-@scoreColor">@diversificationScore.ToString("N0")</div>
                    <p class="text-muted mb-0">/ 100 Puan</p>
                </div>
                <div class="col-md-9">
                    <div class="progress mb-3" style="height: 30px;">
                        <div class="progress-bar bg-@scoreColor" role="progressbar"
                             style="width: @diversificationScore%"
                             aria-valuenow="@diversificationScore" aria-valuemin="0" aria-valuemax="100">
                            @diversificationScore.ToString("N0")%
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-6 col-lg-3">
                            <div class="small text-muted">Hisse Sayısı</div>
                            <strong>@diversification["NumberOfHoldings"]</strong>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="small text-muted">Sektör Sayısı</div>
                            <strong>@diversification["NumberOfSectors"]</strong>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="small text-muted">HHI İndeksi</div>
                            <strong>@((double)diversification["HHI"]).ToString("N0")</strong>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="small text-muted">İlk 5 Konsantrasyon</div>
                            <strong>%@((double)diversification["Top5Concentration"]).ToString("N1")</strong>
                        </div>
                    </div>
                    <div class="alert alert-@scoreColor mt-3 mb-0">
                        <small>
                            <i class="bi bi-info-circle"></i>
                            @if (diversificationScore >= 70)
                            {
                                <text>Mükemmel! Portföyünüz iyi çeşitlendirilmiş durumda.</text>
                            }
                            else if (diversificationScore >= 50)
                            {
                                <text>İyi! Portföyünüzü daha fazla çeşitlendirmeyi düşünebilirsiniz.</text>
                            }
                            else
                            {
                                <text>Dikkat! Portföyünüz yeterince çeşitlendirilmemiş. Riski azaltmak için farklı sektörlerden hisseler eklemeyi düşünün.</text>
                            }
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Risk Metrics -->
@if (riskMetrics != null && riskMetrics.Any())
{
    var volatility = (double)riskMetrics["Volatility"];
    var riskLevel = (string)riskMetrics["RiskLevel"];
    var riskColor = riskLevel == "Düşük" ? "success" : riskLevel == "Orta" ? "warning" : "danger";

    <div class="row mb-4 g-3">
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-activity"></i> Risk Metrikleri</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="card border-@riskColor">
                                <div class="card-body text-center">
                                    <h6 class="text-muted small mb-2">Risk Seviyesi</h6>
                                    <h4 class="mb-0 text-@riskColor">@riskLevel</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card border-info">
                                <div class="card-body text-center">
                                    <h6 class="text-muted small mb-2">Volatilite</h6>
                                    <h4 class="mb-0 text-info">@volatility.ToString("N2")%</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card border-success">
                                <div class="card-body text-center">
                                    <h6 class="text-muted small mb-2">Ort. Getiri</h6>
                                    <h4 class="mb-0 text-success">@((decimal)riskMetrics["AverageReturn"]).ToString("N2")%</h4>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="card border-warning">
                                <div class="card-body text-center">
                                    <h6 class="text-muted small mb-2">Sharpe Oranı</h6>
                                    <h4 class="mb-0 text-warning">@((double)riskMetrics["SharpeRatio"]).ToString("N2")</h4>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <canvas id="riskChart" height="80"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 border-info">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle"></i> Risk Açıklaması</h6>
                </div>
                <div class="card-body">
                    <h6>Volatilite</h6>
                    <p class="small">Getirilerinizin ne kadar dalgalı olduğunu gösterir. Düşük volatilite daha stabil getiri anlamına gelir.</p>

                    <h6 class="mt-3">Sharpe Oranı</h6>
                    <p class="small">Risk-getiri dengesini ölçer. Yüksek değer, aldığınız riske göre iyi getiri elde ettiğinizi gösterir.</p>

                    <h6 class="mt-3">Maksimum Düşüş</h6>
                    <p class="small mb-0">En kötü performans gösteren hissenizin kaybı:
                        <strong class="text-danger">@((decimal)riskMetrics["MaxDrawdown"]).ToString("N2")%</strong>
                    </p>
                </div>
            </div>
        </div>
    </div>
}

<!-- Sector Concentration & Top Holdings -->
<div class="row mb-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-diagram-3"></i> Sektör Dağılımı</h5>
            </div>
            <div class="card-body">
                @if (sectorConcentration != null && ((IEnumerable<dynamic>)sectorConcentration).Any())
                {
                    <canvas id="sectorChart" height="250"></canvas>
                    <div class="table-responsive mt-3">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Sektör</th>
                                    <th class="text-end">Hisse</th>
                                    <th class="text-end">Değer</th>
                                    <th class="text-end">Oran</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sector in sectorConcentration)
                                {
                                    <tr>
                                        <td>@sector.Sector</td>
                                        <td class="text-end">@sector.Count</td>
                                        <td class="text-end">₺@sector.Value.ToString("N2")</td>
                                        <td class="text-end">
                                            <span class="badge bg-primary">@sector.Percentage.ToString("N1")%</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-center text-muted py-5">Sektör verisi yok</p>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="bi bi-trophy"></i> En Büyük 10 Pozisyon</h5>
            </div>
            <div class="card-body">
                @if (topHoldings != null && ((IEnumerable<dynamic>)topHoldings).Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover">
                            <thead>
                                <tr>
                                    <th>Sıra</th>
                                    <th>Hisse</th>
                                    <th class="text-end">Değer</th>
                                    <th class="text-end">Oran</th>
                                    <th class="text-end">K/Z</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{int rank = 1;}
                                @foreach (var holding in topHoldings)
                                {
                                    <tr>
                                        <td>
                                            @if (rank <= 3)
                                            {
                                                <i class="bi bi-award-fill text-warning"></i>
                                            }
                                            <strong>@rank</strong>
                                        </td>
                                        <td>
                                            <strong>@holding.Code</strong><br />
                                            <small class="text-muted">@holding.Name</small>
                                        </td>
                                        <td class="text-end">₺@holding.Value.ToString("N2")</td>
                                        <td class="text-end">
                                            <span class="badge bg-info">@holding.Percentage.ToString("N1")%</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="badge @(holding.ProfitLoss >= 0 ? "bg-success" : "bg-danger")">
                                                @(holding.ProfitLoss >= 0 ? "+" : "")@holding.ProfitLossPercentage.ToString("N1")%
                                            </span>
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-center text-muted py-5">Pozisyon verisi yok</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Portfolio Summary -->
@if (portfolioSummary != null)
{
    <div class="card">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0"><i class="bi bi-briefcase"></i> Portföy Özeti</h5>
        </div>
        <div class="card-body">
            <div class="row text-center g-3">
                <div class="col-6 col-md-2">
                    <h6 class="text-muted small">Toplam Değer</h6>
                    <h5 class="mb-0">₺@portfolioSummary.TotalValue.ToString("N2")</h5>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="text-muted small">Toplam Maliyet</h6>
                    <h5 class="mb-0">₺@portfolioSummary.TotalCost.ToString("N2")</h5>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="text-muted small">Kar/Zarar</h6>
                    <h5 class="mb-0 text-@(portfolioSummary.TotalProfitLoss >= 0 ? "success" : "danger")">
                        ₺@portfolioSummary.TotalProfitLoss.ToString("N2")
                    </h5>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="text-muted small">Getiri %</h6>
                    <h5 class="mb-0 text-@(portfolioSummary.TotalProfitLossPercentage >= 0 ? "success" : "danger")">
                        @(portfolioSummary.TotalProfitLossPercentage >= 0 ? "+" : "")@portfolioSummary.TotalProfitLossPercentage.ToString("N2")%
                    </h5>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="text-muted small">Şirket</h6>
                    <h5 class="mb-0">@portfolioSummary.TotalCompanies</h5>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="text-muted small">Toplam Hisse</h6>
                    <h5 class="mb-0">@portfolioSummary.TotalShares.ToString("N0")</h5>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        @if (sectorConcentration != null && ((IEnumerable<dynamic>)sectorConcentration).Any())
        {
            <text>
            // Sector Distribution Pie Chart
            var sectorCtx = document.getElementById('sectorChart').getContext('2d');
            new Chart(sectorCtx, {
                type: 'doughnut',
                data: {
                    labels: [@Html.Raw(string.Join(",", ((IEnumerable<dynamic>)sectorConcentration).Select(s => $"'{s.Sector}'")))],
                    datasets: [{
                        data: [@Html.Raw(string.Join(",", ((IEnumerable<dynamic>)sectorConcentration).Select(s => s.Percentage.ToString("F2").Replace(",", "."))))],
                        backgroundColor: [
                            '#0d6efd', '#6610f2', '#6f42c1', '#d63384', '#dc3545',
                            '#fd7e14', '#ffc107', '#198754', '#20c997', '#0dcaf0'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'right' },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': %' + context.parsed.toFixed(2);
                                }
                            }
                        }
                    }
                }
            });
            </text>
        }

        @if (riskMetrics != null && riskMetrics.Any())
        {
            var volatility = (double)riskMetrics["Volatility"];
            var avgReturn = (decimal)riskMetrics["AverageReturn"];

            <text>
            // Risk Chart
            var riskCtx = document.getElementById('riskChart').getContext('2d');
            new Chart(riskCtx, {
                type: 'bar',
                data: {
                    labels: ['Volatilite', 'Ortalama Getiri', 'Düşük Risk (10%)', 'Orta Risk (20%)'],
                    datasets: [{
                        label: 'Risk Metrikleri (%)',
                        data: [@volatility.ToString("F2").Replace(",", "."), @avgReturn.ToString("F2").Replace(",", "."), 10, 20],
                        backgroundColor: ['#dc3545', '#198754', '#0d6efd', '#ffc107']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: { display: true, text: 'Yüzde (%)' }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
