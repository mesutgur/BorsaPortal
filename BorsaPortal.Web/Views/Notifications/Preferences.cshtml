@model BorsaPortal.Domain.Entities.UserPreference
@{
    ViewBag.Title = "Bildirim Tercihleri";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2><i class="bi bi-gear"></i> Bildirim Tercihleri</h2>
                <p class="text-muted">Bildirim ayarlarınızı yönetin</p>
            </div>
            <div>
                <a href="@Url.Action("Index", "Notifications")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Bildirimlere Dön
                </a>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-toggles"></i> Bildirim Ayarları</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("UpdatePreferences", "Notifications", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-bell"></i> Bildirim Türleri
                        </h6>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" name="targetPriceNotifications"
                                   id="targetPriceNotifications" @(Model?.TargetPriceNotifications == true ? "checked" : "")>
                            <label class="form-check-label" for="targetPriceNotifications">
                                <strong>Hedef Fiyat Bildirimleri</strong>
                                <br />
                                <small class="text-muted">
                                    İzleme listenizde hedef fiyata ulaşan hisselerin bildirimleri
                                </small>
                            </label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" name="kapNotifications"
                                   id="kapNotifications" @(Model?.KapNotifications == true ? "checked" : "")>
                            <label class="form-check-label" for="kapNotifications">
                                <strong>KAP Bildirimleri</strong>
                                <br />
                                <small class="text-muted">
                                    Portföyünüzdeki ve izleme listenizdeki şirketlerin KAP bildirimleri
                                </small>
                            </label>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" name="newsNotifications"
                                   id="newsNotifications" @(Model?.NewsNotifications == true ? "checked" : "")>
                            <label class="form-check-label" for="newsNotifications">
                                <strong>Haber Bildirimleri</strong>
                                <br />
                                <small class="text-muted">
                                    Portföyünüzdeki şirketler hakkındaki önemli haberler
                                </small>
                            </label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="bi bi-envelope"></i> E-posta Bildirimleri
                        </h6>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" name="emailNotifications"
                                   id="emailNotifications" @(Model?.EmailNotifications == true ? "checked" : "")>
                            <label class="form-check-label" for="emailNotifications">
                                <strong>E-posta ile Bildirim</strong>
                                <br />
                                <small class="text-muted">
                                    Önemli bildirimleri e-posta olarak alın
                                </small>
                            </label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Günlük Özet Saati</label>
                            <input type="time" name="dailyDigestTime" class="form-control"
                                   value="@(Model?.DailyDigestTime ?? "09:00")" style="max-width: 200px;">
                            <small class="text-muted">
                                Günlük portföy özeti ve bildirimlerin e-posta ile gönderilme saati
                            </small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Index", "Notifications")" class="btn btn-secondary">
                            <i class="bi bi-x"></i> İptal
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check"></i> Kaydet
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4 border-info">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Bilgi</h6>
            </div>
            <div class="card-body">
                <h6>Hedef Fiyat Bildirimleri</h6>
                <p class="small">
                    İzleme listenizde hedef fiyat belirlediğiniz hisseler bu fiyata ulaştığında bildirim alırsınız.
                </p>

                <h6 class="mt-3">KAP Bildirimleri</h6>
                <p class="small">
                    Portföyünüzdeki ve izleme listenizdeki şirketlerle ilgili yeni KAP bildirimleri yayınlandığında haberdar olursunuz.
                </p>

                <h6 class="mt-3">E-posta Bildirimleri</h6>
                <p class="small">
                    Aktif ettiğinizde önemli bildirimler kayıtlı e-posta adresinize de gönderilir.
                </p>
            </div>
        </div>

        <div class="card border-warning">
            <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-lightbulb"></i> İpuçları</h6>
            </div>
            <div class="card-body">
                <ul class="small mb-0">
                    <li class="mb-2">Hedef fiyat belirleyerek otomatik bildirim alabilirsiniz</li>
                    <li class="mb-2">Günlük özet ile portföyünüzü her sabah kontrol edebilirsiniz</li>
                    <li class="mb-2">Önemli KAP bildirimlerini kaçırmayın</li>
                </ul>
            </div>
        </div>
    </div>
</div>
