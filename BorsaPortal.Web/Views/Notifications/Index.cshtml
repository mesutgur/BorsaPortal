@model List<BorsaPortal.Domain.Entities.UserNotification>
@{
    ViewBag.Title = "Bildirimler";
    var filter = ViewBag.Filter as string ?? "all";
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2>
                    <i class="bi bi-bell"></i> Bildirimler
                    @if (unreadCount > 0)
                    {
                        <span class="badge bg-danger">@unreadCount</span>
                    }
                </h2>
                <p class="text-muted">Hedef fiyat, KAP ve sistem bildirimleri</p>
            </div>
            <div>
                @if (unreadCount > 0)
                {
                    @using (Html.BeginForm("MarkAllAsRead", "Notifications", FormMethod.Post, new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-check-all"></i> Tümünü Okundu İşaretle
                        </button>
                    }
                }
                <a href="@Url.Action("Preferences", "Notifications")" class="btn btn-primary">
                    <i class="bi bi-gear"></i> Bildirim Ayarları
                </a>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter Tabs -->
<ul class="nav nav-pills mb-4">
    <li class="nav-item">
        <a class="nav-link @(filter == "all" ? "active" : "")" href="@Url.Action("Index", new { filter = "all" })">
            <i class="bi bi-inbox"></i> Tümü (@Model.Count)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(filter == "unread" ? "active" : "")" href="@Url.Action("Index", new { filter = "unread" })">
            <i class="bi bi-envelope"></i> Okunmamış
            @if (unreadCount > 0)
            {
                <span class="badge bg-danger">@unreadCount</span>
            }
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(filter == "targetprice" ? "active" : "")" href="@Url.Action("Index", new { filter = "targetprice" })">
            <i class="bi bi-bullseye"></i> Hedef Fiyat
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(filter == "kap" ? "active" : "")" href="@Url.Action("Index", new { filter = "kap" })">
            <i class="bi bi-megaphone"></i> KAP
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(filter == "system" ? "active" : "")" href="@Url.Action("Index", new { filter = "system" })">
            <i class="bi bi-info-circle"></i> Sistem
        </a>
    </li>
</ul>

<!-- Notifications List -->
@if (Model != null && Model.Any())
{
    <div class="card">
        <div class="list-group list-group-flush">
            @foreach (var notification in Model)
            {
                var iconClass = notification.NotificationType switch
                {
                    "TargetPrice" => "bi-bullseye text-success",
                    "KAP" => "bi-megaphone text-info",
                    "News" => "bi-newspaper text-warning",
                    "System" => "bi-info-circle text-primary",
                    _ => "bi-bell text-secondary"
                };

                var bgClass = notification.IsRead ? "" : "bg-light";

                <div class="list-group-item @bgClass">
                    <div class="d-flex w-100 justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-start mb-2">
                                <i class="bi @iconClass fs-4 me-3"></i>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1 @(notification.IsRead ? "" : "fw-bold")">
                                        @notification.Title
                                        @if (!notification.IsRead)
                                        {
                                            <span class="badge bg-primary badge-sm ms-2">Yeni</span>
                                        }
                                    </h6>
                                    <p class="mb-2 text-muted">@notification.Message</p>
                                    <small class="text-muted">
                                        <i class="bi bi-clock"></i> @notification.NotificationDate.ToString("dd MMMM yyyy HH:mm")
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div class="ms-3">
                            <div class="btn-group">
                                @if (!string.IsNullOrEmpty(notification.ActionUrl))
                                {
                                    <a href="@notification.ActionUrl" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-arrow-right"></i> Görüntüle
                                    </a>
                                }
                                @if (!notification.IsRead)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="markAsRead(@notification.Id)">
                                        <i class="bi bi-check"></i> Okundu
                                    </button>
                                }
                                @using (Html.BeginForm("Delete", "Notifications", new { id = notification.Id }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu bildirimi silmek istediğinize emin misiniz?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-bell-slash" style="font-size: 4rem; opacity: 0.2;"></i>
            <h5 class="mt-3 text-muted">Bildirim Yok</h5>
            <p class="text-muted">
                @if (filter == "unread")
                {
                    <text>Okunmamış bildiriminiz bulunmuyor.</text>
                }
                else
                {
                    <text>Henüz bildiriminiz bulunmuyor. Hedef fiyat belirlediğinizde bildirimler burada görünecektir.</text>
                }
            </p>
            @if (filter != "all")
            {
                <a href="@Url.Action("Index", new { filter = "all" })" class="btn btn-primary">
                    <i class="bi bi-arrow-left"></i> Tüm Bildirimleri Gör
                </a>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        function markAsRead(notificationId) {
            $.ajax({
                url: '@Url.Action("MarkAsRead", "Notifications")',
                type: 'POST',
                data: {
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val(),
                    id: notificationId
                },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    }
                },
                error: function() {
                    alert('Bildirim okundu olarak işaretlenemedi.');
                }
            });
        }
    </script>
}
