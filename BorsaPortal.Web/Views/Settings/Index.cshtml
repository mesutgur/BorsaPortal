@model BorsaPortal.Domain.Entities.UserPreference

@{
    ViewBag.Title = "Ayarlar";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-gear"></i> Ayarlar</h2>
        <p class="text-muted">Bildirim, görünüm ve gizlilik ayarlarınızı yönetin</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="list-group">
            <a href="#notifications" class="list-group-item list-group-item-action active" data-bs-toggle="list">
                <i class="bi bi-bell"></i> Bildirimler
            </a>
            <a href="#display" class="list-group-item list-group-item-action" data-bs-toggle="list">
                <i class="bi bi-display"></i> Görünüm
            </a>
            <a href="#alerts" class="list-group-item list-group-item-action" data-bs-toggle="list">
                <i class="bi bi-exclamation-triangle"></i> Fiyat Uyarıları
            </a>
            <a href="#privacy" class="list-group-item list-group-item-action" data-bs-toggle="list">
                <i class="bi bi-shield-lock"></i> Gizlilik
            </a>
            <a href="@Url.Action("UserProfile")" class="list-group-item list-group-item-action">
                <i class="bi bi-person"></i> Profil Bilgileri
            </a>
        </div>
    </div>

    <div class="col-md-9">
        @using (Html.BeginForm("Update", "Settings", FormMethod.Post, new { @class = "needs-validation" }))
        {
            @Html.AntiForgeryToken()

            <div class="tab-content">
                <!-- Notifications Tab -->
                <div class="tab-pane fade show active" id="notifications">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-bell"></i> Bildirim Ayarları</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-4">
                                <h6 class="text-muted mb-3">Bildirim Kanalları</h6>
                                <div class="form-check form-switch mb-3">
                                    @Html.CheckBoxFor(m => m.EmailNotificationsEnabled, new { @class = "form-check-input", id = "emailNotif" })
                                    <label class="form-check-label" for="emailNotif">
                                        <strong>E-posta Bildirimleri</strong>
                                        <br /><small class="text-muted">Önemli güncellemeleri e-posta ile al</small>
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    @Html.CheckBoxFor(m => m.SmsNotificationsEnabled, new { @class = "form-check-input", id = "smsNotif" })
                                    <label class="form-check-label" for="smsNotif">
                                        <strong>SMS Bildirimleri</strong>
                                        <br /><small class="text-muted">Kritik uyarıları SMS ile al</small>
                                    </label>
                                </div>
                                <div class="form-check form-switch">
                                    @Html.CheckBoxFor(m => m.PushNotificationsEnabled, new { @class = "form-check-input", id = "pushNotif" })
                                    <label class="form-check-label" for="pushNotif">
                                        <strong>Push Bildirimleri</strong>
                                        <br /><small class="text-muted">Tarayıcı bildirimleri (Web Push)</small>
                                    </label>
                                </div>
                            </div>

                            <hr />

                            <div class="mb-3">
                                <h6 class="text-muted mb-3">Bildirim Tercihleri</h6>
                                <div class="form-check mb-2">
                                    @Html.CheckBoxFor(m => m.NotifyOnKapDisclosures, new { @class = "form-check-input", id = "kapNotif" })
                                    <label class="form-check-label" for="kapNotif">
                                        KAP Bildirimleri
                                    </label>
                                </div>
                                <div class="form-check mb-2">
                                    @Html.CheckBoxFor(m => m.NotifyOnPriceChanges, new { @class = "form-check-input", id = "priceNotif" })
                                    <label class="form-check-label" for="priceNotif">
                                        Fiyat Değişimleri
                                    </label>
                                </div>
                                <div class="form-check">
                                    @Html.CheckBoxFor(m => m.NotifyOnNewsPublished, new { @class = "form-check-input", id = "newsNotif" })
                                    <label class="form-check-label" for="newsNotif">
                                        Yeni Haberler
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Display Settings Tab -->
                <div class="tab-pane fade" id="display">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-display"></i> Görünüm Ayarları</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label">Tercih Edilen Dil</label>
                                @Html.DropDownListFor(m => m.PreferredLanguage,
                                    new SelectList(new[] {
                                        new { Value = "tr-TR", Text = "Türkçe" },
                                        new { Value = "en-US", Text = "English" }
                                    }, "Value", "Text", Model.PreferredLanguage),
                                    new { @class = "form-select" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Tercih Edilen Para Birimi</label>
                                @Html.DropDownListFor(m => m.PreferredCurrency,
                                    new SelectList(new[] {
                                        new { Value = "TRY", Text = "Türk Lirası (₺)" },
                                        new { Value = "USD", Text = "Amerikan Doları ($)" },
                                        new { Value = "EUR", Text = "Euro (€)" }
                                    }, "Value", "Text", Model.PreferredCurrency),
                                    new { @class = "form-select" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Sayfa Başına Gösterilecek Öğe Sayısı</label>
                                @Html.DropDownListFor(m => m.ItemsPerPage,
                                    new SelectList(new[] { 10, 20, 50, 100 }, Model.ItemsPerPage),
                                    new { @class = "form-select" })
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Price Alerts Tab -->
                <div class="tab-pane fade" id="alerts">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Fiyat Uyarıları</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-4">
                                <label class="form-label">Fiyat Değişim Uyarısı (%)</label>
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.PriceChangeAlertPercentage, new { @class = "form-control", type = "number", step = "0.1", min = "0", placeholder = "Örn: 5" })
                                    <span class="input-group-text">%</span>
                                </div>
                                <small class="text-muted">Hisse fiyatları bu oranda değiştiğinde bildirim al (boş bırakılırsa pasif)</small>
                            </div>

                            <hr />

                            <div class="mb-3">
                                <h6 class="text-muted mb-3">Günlük Özet</h6>
                                <div class="form-check form-switch mb-3">
                                    @Html.CheckBoxFor(m => m.DailyDigestEnabled, new { @class = "form-check-input", id = "dailyDigest" })
                                    <label class="form-check-label" for="dailyDigest">
                                        <strong>Günlük Özet E-postası Gönder</strong>
                                        <br /><small class="text-muted">Portföyünüz ve izleme listeniz hakkında günlük rapor</small>
                                    </label>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Günlük Özet Saati</label>
                                    @Html.TextBoxFor(m => m.DailyDigestTime, new { @class = "form-control", type = "time", placeholder = "09:00" })
                                    <small class="text-muted">Günlük özet e-postasının gönderileceği saat (HH:mm)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Privacy Tab -->
                <div class="tab-pane fade" id="privacy">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="bi bi-shield-lock"></i> Gizlilik Ayarları</h5>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> Gelecekte sosyal özellikler eklendiğinde bu ayarlar kullanılacaktır.
                            </div>

                            <div class="form-check form-switch mb-3">
                                @Html.CheckBoxFor(m => m.ProfileVisible, new { @class = "form-check-input", id = "profileVisible" })
                                <label class="form-check-label" for="profileVisible">
                                    <strong>Profil Görünürlüğü</strong>
                                    <br /><small class="text-muted">Profilimi diğer kullanıcılara göster</small>
                                </label>
                            </div>

                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(m => m.PortfolioVisible, new { @class = "form-check-input", id = "portfolioVisible" })
                                <label class="form-check-label" for="portfolioVisible">
                                    <strong>Portföy Görünürlüğü</strong>
                                    <br /><small class="text-muted">Portföyümü diğer kullanıcılara göster</small>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-check-circle"></i> Ayarları Kaydet
                </button>
                <a href="@Url.Action("Index", "UserDashboard")" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-x-circle"></i> İptal
                </a>
            </div>
        }
    </div>
</div>
