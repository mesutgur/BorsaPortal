@model IEnumerable<BorsaPortal.Domain.Entities.BlogPost>
@using BorsaPortal.Domain.Enums

@{
    ViewBag.Title = "Blog Yazıları Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Blog Yazıları</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Yeni Blog Yazısı
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <label class="form-label">Kategori</label>
                @Html.DropDownList("categoryId", (SelectList)ViewBag.Categories, "-- Tüm Kategoriler --", new { @class = "form-select" })
            </div>
            <div class="col-md-4">
                <label class="form-label">Durum</label>
                @Html.DropDownList("status", (SelectList)ViewBag.Statuses, "-- Tüm Durumlar --", new { @class = "form-select" })
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">
                    <i class="bi bi-funnel"></i> Filtrele
                </button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> Temizle
                </a>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Başlık</th>
                            <th>Kategori</th>
                            <th>Yazar</th>
                            <th>Durum</th>
                            <th>Yayın Tarihi</th>
                            <th>Görüntülenme</th>
                            <th style="width: 200px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Title</strong>
                                    @if (!string.IsNullOrEmpty(item.Summary))
                                    {
                                        <br />
                                        <small class="text-muted">@(item.Summary.Length > 100 ? item.Summary.Substring(0, 100) + "..." : item.Summary)</small>
                                    }
                                    <br />
                                    <small class="text-muted">
                                        <i class="bi bi-link-45deg"></i> /@item.Slug
                                    </small>
                                </td>
                                <td>
                                    @if (item.Category != null)
                                    {
                                        <span class="badge bg-info">@item.Category.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Author != null)
                                    {
                                        @item.Author.Email
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case PublishStatus.Published:
                                            <span class="badge bg-success">Yayında</span>
                                            break;
                                        case PublishStatus.Draft:
                                            <span class="badge bg-warning text-dark">Taslak</span>
                                            break;
                                        case PublishStatus.Archived:
                                            <span class="badge bg-secondary">Arşivlendi</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (item.PublishedAt.HasValue)
                                    {
                                        @item.PublishedAt.Value.ToString("dd.MM.yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Henüz yayınlanmadı</span>
                                    }
                                </td>
                                <td>
                                    <i class="bi bi-eye"></i> @item.ViewCount
                                    <br />
                                    <small class="text-muted">
                                        <i class="bi bi-chat"></i> @item.CommentCount yorum
                                    </small>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning" title="Düzenle">
                                            <i class="bi bi-pencil"></i> Düzenle
                                        </a>
                                        <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger" title="Sil">
                                            <i class="bi bi-trash"></i> Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Henüz blog yazısı bulunmamaktadır.
    </div>
}
