@model BorsaPortal.Domain.Entities.Sector

@{
    ViewBag.Title = Model.Name + " Sektörü";
    var companies = ViewBag.Companies as List<BorsaPortal.Domain.Entities.Company> ?? new List<BorsaPortal.Domain.Entities.Company>();
}

<div class="container-fluid">
    <!-- Breadcrumb -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Sectors")">Sektörler</a></li>
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>
    </div>

    <!-- Sector Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-start border-primary border-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h1 class="mb-2">
                                <i class="bi bi-diagram-3 text-primary"></i> @Model.Name
                            </h1>
                            @if (!string.IsNullOrEmpty(Model.Code))
                            {
                                <p class="text-muted mb-2">
                                    <strong>Sektör Kodu:</strong> @Model.Code
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(Model.Description))
                            {
                                <p class="mb-0">@Model.Description</p>
                            }
                        </div>
                        <div class="text-end">
                            <div class="bg-primary bg-opacity-10 p-3 rounded">
                                <h6 class="text-muted mb-1">Şirket Sayısı</h6>
                                <h2 class="mb-0 text-primary">@companies.Count</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="btn-group" role="group">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Tüm Sektörler
                </a>
                <a href="@Url.Action("Analysis")" class="btn btn-outline-primary">
                    <i class="bi bi-graph-up-arrow"></i> Sektörel Analiz
                </a>
            </div>
        </div>
    </div>

    <!-- Companies List -->
    @if (companies.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">
                    <i class="bi bi-building"></i> Sektördeki Şirketler
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="row g-0">
                    @foreach (var company in companies)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="company-item p-3 border-bottom border-end">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <h6 class="mb-0">
                                            <a href="@Url.Action("Details", "Companies", new { id = company.Id })" class="text-decoration-none">
                                                <strong>@company.Code</strong>
                                            </a>
                                        </h6>
                                        <small class="text-muted">@company.Name</small>
                                    </div>
                                    @if (!string.IsNullOrEmpty(company.LogoUrl))
                                    {
                                        <img src="@company.LogoUrl" alt="@company.Code"
                                             class="company-logo" style="width: 30px; height: 30px; object-fit: contain;">
                                    }
                                </div>

                                <div class="d-grid">
                                    <a href="@Url.Action("Details", "Companies", new { id = company.Id })"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-graph-up"></i> Detaylar
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-inbox fs-1"></i>
            <h4 class="mt-3">Bu sektörde şirket bulunamadı</h4>
            <p class="text-muted">Henüz bu sektörde kayıtlı şirket bulunmuyor.</p>
        </div>
    }
</div>

@section Styles {
    <style>
        .company-item {
            transition: background-color 0.2s;
        }

        .company-item:hover {
            background-color: rgba(13, 110, 253, 0.05);
        }

        .company-logo {
            border-radius: 5px;
            padding: 3px;
            background: #f8f9fa;
        }
    </style>
}
