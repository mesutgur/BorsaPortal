@model List<BorsaPortal.Domain.Entities.Watchlist>

@{
    ViewBag.Title = "İzleme Listesi";
    var companies = ViewBag.Companies as System.Collections.Generic.List<BorsaPortal.Web.Controllers.WatchlistCompanyDto>;
    var stockPrices = ViewBag.StockPrices as System.Collections.Generic.Dictionary<string, BorsaPortal.Application.Services.StockPriceData>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="bi bi-star"></i> İzleme Listesi</h2>
        <p class="text-muted">Favori şirketlerinizi takip edin ve hedef fiyat belirleyin</p>
    </div>
    <div>
        @if (Model != null && Model.Any())
        {
            using (Html.BeginForm("UpdatePrices", "Watchlist", FormMethod.Post, new { @class = "d-inline me-2" }))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-repeat"></i> Fiyatları Güncelle
                </button>
            }
        }
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addModal">
            <i class="bi bi-plus-circle"></i> Şirket Ekle
        </button>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="card-title mb-1">
                                    <a href="@Url.Action("Details", "Companies", new { id = item.CompanyId })" class="text-decoration-none">
                                        @item.Company.Code
                                    </a>
                                </h5>
                                <p class="text-muted small mb-0">@item.Company.Name</p>
                                @if (item.Company.Sector != null)
                                {
                                    <span class="badge bg-secondary">@item.Company.Sector.Name</span>
                                }
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="#" onclick="openEditModal(@item.Id, @item.CompanyId, '@item.Company.Code', '@Html.Raw(item.Notes?.Replace("'", "\\'"))', @(item.TargetPrice?.ToString("0.00") ?? "null"), @item.NotifyOnTargetPrice.ToString().ToLower())">
                                            <i class="bi bi-pencil"></i> Düzenle
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="#" onclick="deleteItem(@item.Id, '@item.Company.Code')">
                                            <i class="bi bi-trash"></i> Çıkar
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        @{
                            var priceData = stockPrices != null && stockPrices.ContainsKey(item.Company.Code) ? stockPrices[item.Company.Code] : null;
                        }

                        @if (priceData != null && priceData.IsSuccess)
                        {
                            <div class="border-top pt-2 mb-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <small class="text-muted">Güncel Fiyat</small>
                                        <h4 class="mb-0">₺@priceData.CurrentPrice.ToString("N2")</h4>
                                    </div>
                                    @if (priceData.DayChangePercent.HasValue)
                                    {
                                        <div class="text-end">
                                            <span class="badge @(priceData.DayChangePercent >= 0 ? "bg-success" : "bg-danger")">
                                                @(priceData.DayChangePercent >= 0 ? "+" : "")%@priceData.DayChangePercent.Value.ToString("N2")
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (item.TargetPrice.HasValue)
                        {
                            var targetDistance = priceData != null && priceData.IsSuccess && priceData.CurrentPrice > 0
                                ? ((item.TargetPrice.Value - priceData.CurrentPrice) / priceData.CurrentPrice) * 100
                                : (decimal?)null;

                            <div class="alert alert-info py-2 mb-2">
                                <small>
                                    <i class="bi bi-bullseye"></i> <strong>Hedef:</strong> ₺@item.TargetPrice.Value.ToString("N2")
                                    @if (targetDistance.HasValue)
                                    {
                                        var distanceClass = targetDistance >= 0 ? "text-success" : "text-danger";
                                        <span class="@distanceClass">
                                            (@(targetDistance >= 0 ? "+" : "")%@targetDistance.Value.ToString("N1"))
                                        </span>
                                    }
                                    @if (item.NotifyOnTargetPrice)
                                    {
                                        <text><br /><i class="bi bi-bell"></i> Bildirim aktif</text>
                                    }
                                </small>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(item.Notes))
                        {
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-sticky"></i> @item.Notes
                                </small>
                            </div>
                        }

                        <div class="text-muted small">
                            <i class="bi bi-calendar"></i> Eklenme: @item.AddedAt.ToString("dd.MM.yyyy")
                            @if (priceData != null && priceData.IsSuccess)
                            {
                                <text><br /><i class="bi bi-clock"></i> Güncelleme: @priceData.LastUpdate.ToString("HH:mm")</text>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-light">
                        <div class="row g-2">
                            <div class="col-6">
                                <a href="@Url.Action("Index", "Portfolio")" class="btn btn-sm btn-success w-100"
                                   onclick="event.preventDefault(); alert('Portföy sayfasına gidin ve @item.Company.Code ekleyin');">
                                    <i class="bi bi-plus-circle"></i> Portföye Ekle
                                </a>
                            </div>
                            <div class="col-6">
                                <a href="@Url.Action("Details", "Companies", new { id = item.CompanyId })" class="btn btn-sm btn-primary w-100">
                                    <i class="bi bi-info-circle"></i> Detay
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-star" style="font-size: 4rem; opacity: 0.2;"></i>
            <h5 class="mt-3 text-muted">İzleme Listeniz Boş</h5>
            <p class="text-muted">Takip etmek istediğiniz şirketleri ekleyin ve fiyat hareketlerini kolayca takip edin</p>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addModal">
                <i class="bi bi-plus-circle"></i> İlk Şirketi Ekle
            </button>
        </div>
    </div>
}

<!-- Select2 CSS -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("Add", "Watchlist", FormMethod.Post, new { id = "addForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Şirket Ekle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Şirket *</label>
                        <select name="companyId" id="addCompanyId" class="form-select" required>
                            <option value="">Şirket ara veya seçiniz...</option>
                            @if (companies != null)
                            {
                                var groupedCompanies = companies.GroupBy(c => c.SectorName);
                                foreach (var group in groupedCompanies)
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var company in group)
                                        {
                                            <option value="@company.Id">@company.Code - @company.Name</option>
                                        }
                                    </optgroup>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Hedef Fiyat (₺)</label>
                        <input type="number" name="targetPrice" class="form-control" step="0.01" min="0" placeholder="Örn: 15.50" />
                        <small class="text-muted">Hedef fiyata ulaşıldığında bildirim almak için aşağıdaki kutuyu işaretleyin</small>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" name="notifyOnTargetPrice" class="form-check-input" id="notifyCheck" />
                            <label class="form-check-label" for="notifyCheck">
                                Hedef fiyata ulaşınca beni bilgilendir
                            </label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notlar</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="Bu şirket hakkında notlarınız..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success">Ekle</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("Update", "Watchlist", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="editId" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-pencil"></i> Düzenle: <span id="editCompanyCode"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Hedef Fiyat (₺)</label>
                        <input type="number" name="targetPrice" id="editTargetPrice" class="form-control" step="0.01" min="0" />
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input type="checkbox" name="notifyOnTargetPrice" id="editNotifyCheck" class="form-check-input" />
                            <label class="form-check-label" for="editNotifyCheck">
                                Hedef fiyata ulaşınca beni bilgilendir
                            </label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notlar</label>
                        <textarea name="notes" id="editNotes" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation -->
<form id="deleteForm" method="post" action="@Url.Action("Delete", "Watchlist")" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="deleteId" />
</form>

@section Scripts {
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function() {
            // Initialize Select2
            $('#addCompanyId').select2({
                theme: 'bootstrap-5',
                placeholder: 'Şirket ara veya seçiniz...',
                allowClear: true,
                width: '100%',
                language: {
                    noResults: function() {
                        return "Sonuç bulunamadı";
                    },
                    searching: function() {
                        return "Aranıyor...";
                    }
                }
            });

            // Reinitialize Select2 when modal is shown
            $('#addModal').on('shown.bs.modal', function() {
                $('#addCompanyId').select2({
                    theme: 'bootstrap-5',
                    placeholder: 'Şirket ara veya seçiniz...',
                    allowClear: true,
                    width: '100%',
                    dropdownParent: $('#addModal')
                });
            });

            // Clear form when modal is hidden
            $('#addModal').on('hidden.bs.modal', function() {
                $('#addForm')[0].reset();
                $('#addCompanyId').val('').trigger('change');
            });
        });

        function openEditModal(id, companyId, companyCode, notes, targetPrice, notifyOnTargetPrice) {
            document.getElementById('editId').value = id;
            document.getElementById('editCompanyCode').textContent = companyCode;
            document.getElementById('editNotes').value = notes || '';
            document.getElementById('editTargetPrice').value = targetPrice || '';
            document.getElementById('editNotifyCheck').checked = notifyOnTargetPrice;

            var modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }

        function deleteItem(id, companyCode) {
            if (confirm(companyCode + ' şirketini izleme listenizden çıkarmak istediğinize emin misiniz?')) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}
