@model IEnumerable<BorsaPortal.Web.Areas.Admin.ViewModels.BlogCategoryViewModel>

@{
    ViewBag.Title = "Blog Kategorileri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Blog Kategorileri</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Yeni Kategori Ekle
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Sıra</th>
                            <th>Kategori Adı</th>
                            <th>Slug</th>
                            <th>Yazı Sayısı</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.DisplayOrder</td>
                                <td><strong>@item.Name</strong></td>
                                <td><code>@item.Slug</code></td>
                                <td>
                                    <span class="badge bg-info">@item.PostCount yazı</span>
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                Henüz kategori eklenmemiş. <a href="@Url.Action("Create")">Yeni kategori ekle</a>
            </div>
        }
    </div>
</div>
