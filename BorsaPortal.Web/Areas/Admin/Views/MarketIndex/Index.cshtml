@model IEnumerable<BorsaPortal.Domain.Entities.MarketIndex>

@{
    ViewBag.Title = "Piyasa Endeksleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Piyasa Endeksleri (BIST100, XU030, vb.)</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Yeni Endeks Ekle
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kod</th>
                            <th>Endeks Adı</th>
                            <th>Güncel Değer</th>
                            <th>Ort. F/K</th>
                            <th>Ort. PD/DD</th>
                            <th>Günlük Değişim (%)</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.Code</strong></td>
                                <td>@item.Name</td>
                                <td>@(item.CurrentValue.HasValue ? item.CurrentValue.Value.ToString("N2") : "-")</td>
                                <td>@(item.AveragePE.HasValue ? item.AveragePE.Value.ToString("N2") : "-")</td>
                                <td>@(item.AveragePB.HasValue ? item.AveragePB.Value.ToString("N2") : "-")</td>
                                <td>
                                    @if (item.DailyChange.HasValue)
                                    {
                                        var changeClass = item.DailyChange.Value >= 0 ? "text-success" : "text-danger";
                                        var changeIcon = item.DailyChange.Value >= 0 ? "bi-arrow-up" : "bi-arrow-down";
                                        <span class="@changeClass">
                                            <i class="bi @changeIcon"></i> @item.DailyChange.Value.ToString("N2")%
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-sm btn-outline-primary" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-sm btn-outline-danger" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                Henüz endeks eklenmemiş. <a href="@Url.Action("Create")">Yeni endeks ekle</a>
            </div>
        }
    </div>
</div>
