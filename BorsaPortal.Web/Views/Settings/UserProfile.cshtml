@model BorsaPortal.Domain.Entities.ApplicationUser

@{
    ViewBag.Title = "Profil Bilgileri";
}

<div class="row mb-4">
    <div class="col-12">
        <h2><i class="bi bi-person-circle"></i> Profil Bilgileri</h2>
        <p class="text-muted">Kişisel bilgilerinizi güncelleyin</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="list-group">
            <a href="@Url.Action("Index")" class="list-group-item list-group-item-action">
                <i class="bi bi-gear"></i> Ayarlar
            </a>
            <a href="@Url.Action("UserProfile")" class="list-group-item list-group-item-action active">
                <i class="bi bi-person"></i> Profil Bilgileri
            </a>
        </div>
    </div>

    <div class="col-md-9">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-person"></i> Kişisel Bilgiler</h5>
            </div>
            <div class="card-body">
                @using (Html.BeginForm("UpdateProfile", "Settings", FormMethod.Post, new { @class = "needs-validation" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ad *</label>
                            <input type="text" name="firstName" class="form-control" value="@Model.FirstName" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Soyad *</label>
                            <input type="text" name="lastName" class="form-control" value="@Model.LastName" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">E-posta</label>
                        <input type="email" class="form-control" value="@Model.Email" disabled />
                        <small class="text-muted">E-posta adresiniz değiştirilemez</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Telefon</label>
                        <input type="tel" name="phoneNumber" class="form-control" value="@Model.PhoneNumber" placeholder="+90 (555) 123 45 67" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Üyelik Tarihi</label>
                        <input type="text" class="form-control" value="@Model.CreatedAt.ToString("dd MMMM yyyy")" disabled />
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Bilgileri Güncelle
                            </button>
                            <a href="@Url.Action("Index", "UserDashboard")" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Geri Dön
                            </a>
                        </div>
                        <div>
                            <a href="@Url.Action("ChangePassword", "Manage")" class="btn btn-outline-warning">
                                <i class="bi bi-key"></i> Şifre Değiştir
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Account Info Card -->
        <div class="card mt-4">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> Hesap Bilgileri</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <strong>Kullanıcı Adı:</strong>
                        <p class="text-muted">@Model.UserName</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>E-posta Onayı:</strong>
                        <p class="@(Model.EmailConfirmed ? "text-success" : "text-warning")">
                            @if (Model.EmailConfirmed)
                            {
                                <i class="bi bi-check-circle-fill"></i> <text>Onaylandı</text>
                            }
                            else
                            {
                                <i class="bi bi-exclamation-triangle-fill"></i> <text>Onaylanmadı</text>
                            }
                        </p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <strong>Hesap Durumu:</strong>
                        <p class="@(Model.IsActive ? "text-success" : "text-danger")">
                            @if (Model.IsActive)
                            {
                                <i class="bi bi-check-circle-fill"></i> <text>Aktif</text>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill"></i> <text>Pasif</text>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
